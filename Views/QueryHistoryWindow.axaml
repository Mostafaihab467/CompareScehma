<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SchemaCompare.Controls"
        xmlns:models="clr-namespace:SchemaCompare.Models"
        x:Class="SchemaCompare.Views.QueryHistoryWindow"
        Title="Query History"
        Width="880" Height="620" MinWidth="620" MinHeight="420"
        CanResize="True" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="14">

        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
            <TextBlock Text="🕘 Query history" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="SearchBox" Text="{Binding HistoryFilter, Mode=TwoWay}"
                     PlaceholderText="Search SQL, server, database or error…" Margin="14,0,0,0" />
            <TextBlock Grid.Column="2" Text="{Binding FilteredHistory.Count, StringFormat='{}{0} shown'}"
                       FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{StaticResource OnSurfaceVariant}" />
        </Grid>

        <Border Grid.Row="1" Classes="card" Padding="0">
            <ListBox x:Name="HistoryList" ItemsSource="{Binding FilteredHistory}"
                     SelectedItem="{Binding SelectedHistoryEntry, Mode=TwoWay}"
                     DoubleTapped="HistoryList_DoubleTapped"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:QueryHistoryEntry">
                        <StackPanel Spacing="2" Margin="2,4">
                            <Grid ColumnDefinitions="150,200,90,*,Auto">
                                <TextBlock Text="{Binding TimeText}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding TargetText}" FontSize="11"
                                           Foreground="{StaticResource OnSurfaceVariant}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Scope}" FontSize="11"
                                           Foreground="{StaticResource Primary500}" />
                                <TextBlock Grid.Column="3" Text="{Binding OutcomeText}" FontSize="11"
                                           Foreground="{StaticResource OnSurfaceVariant}" TextTrimming="CharacterEllipsis" Margin="8,0" />
                            </Grid>
                            <TextBlock Text="{Binding Preview}" FontSize="12" FontFamily="Consolas,Menlo,monospace"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="2" Classes="card" Padding="8" Margin="0,10,0,0">
            <StackPanel Spacing="4">
                <TextBlock Text="Selected query" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource OnSurfaceVariant}" />
                <controls:SqlHighlightedEditor x:Name="DetailEditor" IsReadOnly="True" EnableLint="False"
                                               EnableIntelliSense="False" Height="140" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
            <Button x:Name="ClearButton" Classes="danger" Padding="14,6" FontSize="12">
                <TextBlock Text="Clear history" />
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <TextBlock Text="Double-click a row to insert it" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource OnSurfaceVariant}" Margin="0,0,8,0" />
                <Button x:Name="CopyButton" Classes="secondary" Padding="14,6" FontSize="12">
                    <TextBlock Text="Copy" />
                </Button>
                <Button x:Name="InsertButton" Classes="primary" Padding="14,6" FontSize="12"
                        ToolTip.Tip="Insert the selected query at the caret of the SQL editor">
                    <TextBlock Text="Insert into editor" />
                </Button>
                <Button x:Name="CloseButton" Classes="secondary" Padding="14,6" FontSize="12">
                    <TextBlock Text="Close" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
