<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SchemaCompare.ViewModels"
        xmlns:models="clr-namespace:SchemaCompare.Models"
        xmlns:controls="clr-namespace:SchemaCompare.Controls"
        x:Class="SchemaCompare.Views.DiagramWindow"
        x:Name="DiagramRoot"
        Title="DB Diagram" Width="1280" Height="820" MinWidth="700" MinHeight="480"
        CanResize="True" SizeToContent="Manual"
        Background="{StaticResource PageBackground}" WindowStartupLocation="CenterOwner">
    <Design.DataContext><vm:DiagramViewModel /></Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.tableListItem">
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.tableListItem.active">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
        </Style>
    </Window.Styles>

    <LayoutTransformControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </LayoutTransformControl.LayoutTransform>
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Background="{StaticResource HeaderGradient}" Padding="22,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="DB Diagram" FontSize="22" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Load a database, auto-generate the ER diagram, drag tables to arrange. Layout auto-saves." Foreground="#E0D4FF" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Click="Close_Click"><TextBlock Text="Close" /></Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="card" Margin="16,12,16,0" Padding="14">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="2*,*,*,Auto">
                    <controls:SearchableComboBox ItemsSource="{Binding SavedConnections}"
                              SelectedItem="{Binding SelectedSaved}"
                              PlaceholderText="Saved connection…"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:SavedConnection">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </controls:SearchableComboBox>
                    <TextBox Grid.Column="1" Text="{Binding Server}" PlaceholderText="Server" Margin="8,0,0,0" />
                    <TextBox Grid.Column="2" Text="{Binding Database}" PlaceholderText="Database" Margin="8,0,0,0" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Classes="primary" Command="{Binding LoadSchemaCommand}" IsEnabled="{Binding !IsLoading}"><TextBlock Text="Load schema" /></Button>
                        <Button Classes="link" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding !IsLoading}" Margin="6,0,0,0" VerticalAlignment="Center"><TextBlock Text="Test" /></Button>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding AuthMethods}" SelectedItem="{Binding Auth}" Width="250" FontSize="12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:AuthMethod"><TextBlock Text="{Binding Display}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding Username}" PlaceholderText="{Binding Auth.CredentialHint}" Width="160" Margin="16,0,0,0" IsVisible="{Binding Auth.NeedsCredentials}" />
                    <TextBox Text="{Binding Password}" PasswordChar="*" PlaceholderText="Password / secret" Width="160" Margin="8,0,0,0" IsVisible="{Binding Auth.NeedsCredentials}" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search tables…" Width="200" />
                        <Button Classes="secondary" Click="ZoomOut_Click" Padding="12,4" ToolTip.Tip="Zoom out at mouse pointer (view center when pointer is outside canvas)"><TextBlock Text="−" /></Button>
                        <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" MinWidth="46" TextAlignment="Center" FontSize="12" />
                        <Button Classes="secondary" Click="ZoomIn_Click" Padding="12,4" ToolTip.Tip="Zoom in at mouse pointer (view center when pointer is outside canvas)"><TextBlock Text="+" /></Button>
                        <Button Classes="secondary" Click="ResetZoom_Click" Padding="10,4" FontSize="11"><TextBlock Text="100%" /></Button>
                        <Button Classes="secondary" Command="{Binding FitAllCommand}" Padding="10,4" FontSize="11" ToolTip.Tip="Fit all tables at once into view"><TextBlock Text="🧭 Fit All" /></Button>
                        <Rectangle Width="1" Height="20" Fill="{StaticResource CardBorder}" Margin="4,0" VerticalAlignment="Center" />
                        <Button Classes="secondary" Command="{Binding AutoLayoutCommand}"><TextBlock Text="Auto-layout" /></Button>
                        <Button Classes="secondary" Command="{Binding ResetViewCommand}"><TextBlock Text="Reset" /></Button>
                        <Button Classes="secondary" Command="{Binding ToggleLinksCommand}" ToolTip.Tip="Hide or show all relationship lines"><TextBlock Text="{Binding LinksToggleText}" /></Button>
                        <Button Classes="secondary" Command="{Binding SaveDiagramCommand}"><TextBlock Text="Save" /></Button>
                        <Button Classes="secondary" Command="{Binding SaveDiagramAsCommand}"><TextBlock Text="Save as…" /></Button>
                        <Button Classes="secondary" Command="{Binding OpenDiagramFileCommand}"><TextBlock Text="Open…" /></Button>
                    </StackPanel>
                </ScrollViewer>
                <Border IsVisible="{Binding ShowError}" Background="{StaticResource ErrorPanelBg}" BorderBrush="{StaticResource ErrorPanelBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding ErrorMessage}" Classes="errorText" />
                        <Button Grid.Column="1" Classes="secondary" Command="{Binding CopyErrorCommand}" Padding="10,4" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Top"><TextBlock Text="Copy" /></Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="250,6,*" Margin="16,8,16,8" MinHeight="200">
            <Border Classes="card" Padding="0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Border Background="{StaticResource SubtleHeader}" Padding="14,10" CornerRadius="12,12,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Tables" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Classes="link" Command="{Binding ShowAllTablesCommand}" Padding="6,2" FontSize="11"><TextBlock Text="All" /></Button>
                                <Button Classes="link" Command="{Binding HideAllTablesCommand}" Padding="6,2" FontSize="11"><TextBlock Text="None" /></Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="Uncheck to hide. ⌖ focuses a table." FontSize="11" Foreground="{StaticResource OnSurfaceVariant}" Margin="12,6" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FilteredTables}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:DiagramTableNode">
                                    <Border Classes="tableListItem" Classes.active="{Binding IsIsolatedTarget}"
                                            Padding="10,6" Margin="6,2" CornerRadius="8"
                                            ToolTip.Tip="{Binding RelationsTooltipText}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="link" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Command="{Binding #DiagramRoot.DataContext.IsolateRelationsCommand}" CommandParameter="{Binding}"
                                                    Padding="6,2" Margin="4,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FullName}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding HeaderSubtitle}" FontSize="10.5" Foreground="{StaticResource OnSurfaceVariant}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="2" Classes="link" Padding="6,2" VerticalAlignment="Center"
                                                    Command="{Binding #DiagramRoot.DataContext.IsolateRelationsCommand}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="Show relations &amp; dim other tables (click again to restore)"
                                                    IsEnabled="{Binding HasRelations}">
                                                <TextBlock Text="{Binding RelationBadge}" FontSize="12" />
                                            </Button>
                                            <Button Grid.Column="3" Classes="link" Padding="6,2" VerticalAlignment="Center"
                                                    Command="{Binding #DiagramRoot.DataContext.FocusTableCommand}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="Focus this table on the canvas">
                                                <TextBlock Text="⌖" FontSize="14" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" />

            <Border Grid.Column="2" Classes="card" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <!-- Professional Relation Inspector Bar -->
                    <Border Background="#161927" BorderBrush="#2E344E"
                            BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="14,10"
                            IsVisible="{Binding IsIsolated}">
                        <Grid RowDefinitions="Auto,Auto">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="🔗 Active Table" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                                    </Border>
                                    <TextBlock Text="{Binding IsolatedTable}" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding IsolatedSummary}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="secondary" Command="{Binding OrganizeActiveClusterCommand}"
                                            Padding="10,4" FontSize="11" ToolTip.Tip="Re-organize this table's connections and fit to screen">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="🧭" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Text="Organize &amp; Fit" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="secondary" Command="{Binding ClearIsolationCommand}"
                                            Padding="10,4" FontSize="11">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="✕" FontSize="10" VerticalAlignment="Center" />
                                            <TextBlock Text="Clear Highlight" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Horizontal list of relations -->
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0"
                                          IsVisible="{Binding HasActiveTableRelations}">
                                <ItemsControl ItemsSource="{Binding ActiveTableRelations}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:DiagramRelationDisplayItem">
                                            <Border Background="#1E2235" BorderBrush="#333852" BorderThickness="1" CornerRadius="8" Padding="10,6"
                                                    ToolTip.Tip="{Binding FullSummary}">
                                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                    <Border Background="#0F172A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DirectionBadge}" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{Binding DirectionColor}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OtherTable}" FontSize="11.5" FontWeight="Bold" Foreground="#E2E8F0" />
                                                        <TextBlock Text="{Binding MappingText}" FontSize="10" Foreground="#94A3B8" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="link" Padding="6,2" VerticalAlignment="Center"
                                                            Command="{Binding #DiagramRoot.DataContext.FocusRelatedTableCommand}"
                                                            CommandParameter="{Binding OtherTable}"
                                                            ToolTip.Tip="Focus related table on canvas">
                                                        <TextBlock Text="⌖" FontSize="13" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                    <ScrollViewer x:Name="DiagramScroll"
                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                   AllowAutoHide="False"
                                   Background="#0F0F17">
                        <!-- Centering wrapper: keeps zoomed-out content centered in the
                             viewport instead of shunted outside of it. -->
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                            </LayoutTransformControl.LayoutTransform>
                            <Canvas x:Name="DiagramCanvas"
                                    Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                                    Background="#0F0F17" />
                        </LayoutTransformControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- Top-Right Floating Canvas Quick Controls -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14"
                            Background="#D0151824" BorderBrush="#353B55" BorderThickness="1"
                            CornerRadius="8" Padding="4" IsVisible="{Binding HasSchema}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="secondary" Command="{Binding FitAllCommand}" Padding="8,4" FontSize="11"
                                    ToolTip.Tip="Fit all tables onto screen at once">
                                <TextBlock Text="🧭 Fit All" />
                            </Button>
                            <Button Classes="secondary" Command="{Binding AutoLayoutCommand}" Padding="8,4" FontSize="11"
                                    ToolTip.Tip="Organize entire diagram layout">
                                <TextBlock Text="📐 Auto-layout" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasSchema}">
                        <TextBlock Text="🗺" FontSize="56" HorizontalAlignment="Center" />
                        <TextBlock Text="Pick a database and click Load schema" FontSize="16" Foreground="{StaticResource OnSurfaceVariant}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="Tables auto-arrange by foreign keys — then drag them anywhere." FontSize="13" Foreground="{StaticResource OnSurfaceVariant}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border IsVisible="{Binding IsLoading}" Background="#B30B0B10">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Loading schema…" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Primary500}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource SubtleHeader}" Padding="16,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource OnSurfaceVariant}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CountsText}" FontSize="12" Foreground="{StaticResource PrimaryText}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
    </LayoutTransformControl>
</Window>
