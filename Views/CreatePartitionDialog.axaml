<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SchemaCompare.Controls"
        x:Class="SchemaCompare.Views.CreatePartitionDialog"
        Title="Create Partition"
        Width="760" Height="620" MinWidth="640" MinHeight="520"
        CanResize="True" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14">

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="🧩" FontSize="20" VerticalAlignment="Center" />
            <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Options -->
        <Border Grid.Row="1" Classes="card" Padding="12,10">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto,110,Auto,180" ColumnSpacing="8">
                    <TextBlock Text="Partition column:" VerticalAlignment="Center" FontSize="12" />
                    <controls:SearchableComboBox x:Name="ColumnBox" FontSize="12" HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Column="2" Text="Range:" VerticalAlignment="Center" FontSize="12" />
                    <controls:SearchableComboBox x:Name="RangeBox" Grid.Column="3" SelectedIndex="1" FontSize="12">
                        <ComboBoxItem Content="LEFT" />
                        <ComboBoxItem Content="RIGHT" />
                    </controls:SearchableComboBox>
                    <TextBlock Grid.Column="4" Text="Filegroup:" VerticalAlignment="Center" FontSize="12" />
                    <TextBox x:Name="FilegroupBox" Grid.Column="5" Text="PRIMARY" FontSize="12" />
                </Grid>

                <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
                    <StackPanel>
                        <TextBlock Text="Function name:" FontSize="12" />
                        <TextBox x:Name="FuncNameBox" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Scheme name:" FontSize="12" />
                        <TextBox x:Name="SchemeNameBox" FontSize="12" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Boundary values — one per line, in order:" FontSize="12" FontWeight="SemiBold" />
                <TextBox x:Name="BoundariesBox" Height="92" AcceptsReturn="True" TextWrapping="NoWrap" FontSize="12"
                         Watermark="e.g. 2024-01-01 / 2025-01-01 (dates quoted automatically; numbers raw)" />

                <CheckBox x:Name="AlignCheck" FontSize="12" IsVisible="False">
                    <TextBlock x:Name="AlignText" TextWrapping="Wrap" />
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- Script preview -->
        <Border Grid.Row="2" Classes="card" Padding="0" Margin="0,8,0,0">
            <Grid RowDefinitions="Auto,*">
                <Border Background="{StaticResource SubtleHeader}" Padding="10,6">
                    <TextBlock Text="T-SQL preview" FontWeight="Bold" FontSize="12" />
                </Border>
                <controls:SqlHighlightedEditor x:Name="Preview" Grid.Row="1" IsReadOnly="True" EnableLint="False" />
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button x:Name="CancelBtn" Padding="14,7" FontSize="12">
                <TextBlock Text="Cancel" />
            </Button>
            <Button x:Name="ScriptBtn" Classes="secondary" Padding="14,7" FontSize="12">
                <TextBlock Text="📄  Script to Definition Tab" />
            </Button>
            <Button x:Name="ExecuteBtn" Classes="primary" Padding="14,7" FontSize="12">
                <TextBlock Text="▶  Execute" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
