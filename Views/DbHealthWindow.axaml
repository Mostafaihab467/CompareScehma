<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SchemaCompare.ViewModels"
        xmlns:models="clr-namespace:SchemaCompare.Models"
        xmlns:controls="clr-namespace:SchemaCompare.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="880"
        x:Class="SchemaCompare.Views.DbHealthWindow"
        Title="DB Health"
        Width="1280" Height="880" MinWidth="980" MinHeight="640"
        CanResize="True" SizeToContent="Manual"
        Background="{StaticResource PageBackground}" WindowStartupLocation="CenterScreen">
    <Design.DataContext><vm:DbHealthViewModel /></Design.DataContext>

    <LayoutTransformControl>
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">

            <!-- ═══════════ HEADER ═══════════ -->
            <Border Background="{StaticResource HeaderGradient}" CornerRadius="8" Padding="16,10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🩺 DB Health" FontSize="20" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding ServerTitle}" FontSize="12" Foreground="#E0D4FF" Margin="0,2,0,0" />
                    </StackPanel>
                    <controls:SearchableComboBox Grid.Column="2" Width="240" VerticalAlignment="Center" Margin="0,0,8,0"
                              ItemsSource="{Binding SavedConnections}"
                              SelectedItem="{Binding SelectedConnection}"
                              PlaceholderText="Select connection…">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:SavedConnection">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </controls:SearchableComboBox>
                    <Button Grid.Column="3" Background="#40FFFFFF" Foreground="White" CornerRadius="8" Padding="12,7"
                            VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Command="{Binding ConnectCommand}" ToolTip.Tip="Connect and start monitoring">
                        <TextBlock Text="Connect" />
                    </Button>
                    <controls:SearchableComboBox Grid.Column="4" Width="104" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"
                              ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding IntervalSeconds}"
                              ToolTip.Tip="Refresh interval">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat='{}{0} s'}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </controls:SearchableComboBox>
                    <Button Grid.Column="5" Background="#40FFFFFF" Foreground="White" CornerRadius="8" Padding="12,7"
                            VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Command="{Binding TogglePauseCommand}"
                            IsVisible="{Binding !IsPaused}" ToolTip.Tip="Stop live refresh">
                        <TextBlock Text="⏸ Pause" />
                    </Button>
                    <Button Grid.Column="5" Background="#FFF3B0" Foreground="#1E1E2E" CornerRadius="8" Padding="12,7"
                            VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Command="{Binding TogglePauseCommand}"
                            IsVisible="{Binding IsPaused}" ToolTip.Tip="Resume live refresh">
                        <TextBlock Text="▶ Resume" />
                    </Button>
                    <Button Grid.Column="6" Background="#40FFFFFF" Foreground="White" CornerRadius="8" Padding="12,7"
                            VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Command="{Binding RefreshNowCommand}" ToolTip.Tip="Refresh everything now">
                        <TextBlock Text="⟳ Refresh" />
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════ SERVER INFO STRIP ═══════════ -->
            <Border Grid.Row="1" Classes="card" Padding="12,6" Margin="0,8,0,0" IsVisible="{Binding IsConnected}">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="{Binding ServerInfoText}" FontSize="11"
                               Foreground="{StaticResource OnSurfaceVariant}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding UptimeText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Primary500}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding WarningsText}" FontSize="11"
                               Foreground="{StaticResource Amber}" VerticalAlignment="Center" Margin="12,0,0,0"
                               MaxWidth="360" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding WarningsText}" />
                </Grid>
            </Border>

            <!-- ═══════════ TABS ═══════════ -->
            <TabControl Grid.Row="2" Margin="0,8,0,0">

                <!-- ══ OVERVIEW ══ -->
                <TabItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="4" Spacing="8">
                            <WrapPanel>
                                <Border Classes="card" Padding="12,8" Margin="4" MinWidth="140">
                                    <StackPanel>
                                        <TextBlock Text="SQL CPU" FontSize="10" Foreground="{StaticResource OnSurfaceVariant}" />
                                        <TextBlock Text="{Binding CpuNowText}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Primary500}" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="card" Padding="12,8" Margin="4" MinWidth="140">
                                    <StackPanel>
                                        <TextBlock Text="SQL memory" FontSize="10" Foreground="{StaticResource OnSurfaceVariant}" />
                                        <TextBlock Text="{Binding MemoryNowText}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Primary500}" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="card" Padding="12,8" Margin="4" MinWidth="140">
                                    <StackPanel>
                                        <TextBlock Text="Batch requests" FontSize="10" Foreground="{StaticResource OnSurfaceVariant}" />
                                        <TextBlock Text="{Binding BatchNowText}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Primary500}" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="card" Padding="12,8" Margin="4" MinWidth="170">
                                    <StackPanel>
                                        <TextBlock Text="Waiting tasks" FontSize="10" Foreground="{StaticResource OnSurfaceVariant}" />
                                        <TextBlock Text="{Binding WaitingNowText}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Amber}" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="card" Padding="12,8" Margin="4" MinWidth="140">
                                    <StackPanel>
                                        <TextBlock Text="Blocked procs" FontSize="10" Foreground="{StaticResource OnSurfaceVariant}" />
                                        <TextBlock Text="{Binding BlockedNowText}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Error}" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="card" Padding="12,8" Margin="4" MinWidth="140">
                                    <StackPanel>
                                        <TextBlock Text="User connections" FontSize="10" Foreground="{StaticResource OnSurfaceVariant}" />
                                        <TextBlock Text="{Binding ConnectionsNowText}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Primary500}" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="card" Padding="12,8" Margin="4" MinWidth="140">
                                    <StackPanel>
                                        <TextBlock Text="Memory grants pending" FontSize="10" Foreground="{StaticResource OnSurfaceVariant}" />
                                        <TextBlock Text="{Binding GrantsNowText}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Amber}" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="card" Padding="12,8" Margin="4" MinWidth="140">
                                    <StackPanel>
                                        <TextBlock Text="Deadlocks" FontSize="10" Foreground="{StaticResource OnSurfaceVariant}" />
                                        <TextBlock Text="{Binding DeadlocksNowText}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Error}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <WrapPanel>
                                <Border Classes="card" Width="452" Height="204" Padding="12" Margin="4">
                                    <Grid RowDefinitions="Auto,*">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="SQL Server CPU %" FontWeight="Bold" FontSize="13" />
                                            <TextBlock Grid.Column="1" Text="{Binding CpuNowText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Primary500}" />
                                        </Grid>
                                        <controls:MiniChart Grid.Row="1" Series="{Binding CpuSeries}" MaxY="100" Unit="%" />
                                    </Grid>
                                </Border>
                                <Border Classes="card" Width="452" Height="204" Padding="12" Margin="4">
                                    <Grid RowDefinitions="Auto,*">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="SQL memory (MB)" FontWeight="Bold" FontSize="13" />
                                            <TextBlock Grid.Column="1" Text="{Binding MemoryNowText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Primary500}" />
                                        </Grid>
                                        <controls:MiniChart Grid.Row="1" Series="{Binding MemorySeries}" Unit=" MB" />
                                    </Grid>
                                </Border>
                                <Border Classes="card" Width="452" Height="204" Padding="12" Margin="4">
                                    <Grid RowDefinitions="Auto,*">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Batch Requests / sec" FontWeight="Bold" FontSize="13" />
                                            <TextBlock Grid.Column="1" Text="{Binding BatchNowText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Primary500}" />
                                        </Grid>
                                        <controls:MiniChart Grid.Row="1" Series="{Binding BatchSeries}" Unit="/s" />
                                    </Grid>
                                </Border>
                                <Border Classes="card" Width="452" Height="204" Padding="12" Margin="4">
                                    <Grid RowDefinitions="Auto,*">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Waiting tasks" FontWeight="Bold" FontSize="13" />
                                            <TextBlock Grid.Column="1" Text="{Binding WaitingNowText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Amber}" />
                                        </Grid>
                                        <controls:MiniChart Grid.Row="1" Series="{Binding WaitingSeries}" />
                                    </Grid>
                                </Border>
                                <Border Classes="card" Width="452" Height="204" Padding="12" Margin="4">
                                    <Grid RowDefinitions="Auto,*">
                                        <TextBlock Text="Page Splits / sec" FontWeight="Bold" FontSize="13" />
                                        <controls:MiniChart Grid.Row="1" Series="{Binding PageSplitsSeries}" Unit="/s" />
                                    </Grid>
                                </Border>
                                <Border Classes="card" Width="452" Height="204" Padding="12" Margin="4">
                                    <Grid RowDefinitions="Auto,*">
                                        <TextBlock Text="Page Life Expectancy (s)" FontWeight="Bold" FontSize="13" />
                                        <controls:MiniChart Grid.Row="1" Series="{Binding PleSeries}" Unit=" s" />
                                    </Grid>
                                </Border>
                                <Border Classes="card" Width="452" Height="204" Padding="12" Margin="4">
                                    <Grid RowDefinitions="Auto,*">
                                        <TextBlock Text="Buffer cache hit ratio %" FontWeight="Bold" FontSize="13" />
                                        <controls:MiniChart Grid.Row="1" Series="{Binding CacheHitSeries}" MaxY="100" Unit="%" />
                                    </Grid>
                                </Border>
                                <Border Classes="card" Width="452" Height="204" Padding="12" Margin="4">
                                    <Grid RowDefinitions="Auto,*">
                                        <TextBlock Text="Deadlocks / sec  •  Lock Waits / sec" FontWeight="Bold" FontSize="13" />
                                        <controls:MiniChart Grid.Row="1" Series="{Binding DeadlockSeries}" Unit="/s" />
                                    </Grid>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ══ PROCESSES ══ -->
                <TabItem Header="Processes">
                    <Grid Margin="4" RowDefinitions="Auto,Auto,*">
                        <Border Classes="card" Padding="10,6" Margin="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <CheckBox Content="Only blocked" IsChecked="{Binding OnlyBlocking}"
                                          ToolTip.Tip="Show only sessions waiting on another session" />
                                <TextBox Width="240" Text="{Binding ProcessesFilter}"
                                         PlaceholderText="Filter db / login / program / spid…" />
                                <Button Classes="secondary" Command="{Binding ShowBlockingChainCommand}" Padding="12,5" FontSize="12"
                                        IsVisible="{Binding HasSelectedProcess}"
                                        ToolTip.Tip="Walk blocking_session_id from the selected session up to the head blocker">
                                    <TextBlock Text="🔗 Blocking chain" />
                                </Button>
                                <Button Classes="danger" Command="{Binding KillSessionCommand}" Padding="12,5" FontSize="12"
                                        IsVisible="{Binding HasSelectedProcess}"
                                        ToolTip.Tip="KILL the selected session — it rolls back uncommitted work">
                                    <TextBlock Text="✖ Kill session" />
                                </Button>
                                <TextBlock Text="{Binding ProcessesSummaryText}" FontSize="11"
                                           Foreground="{StaticResource OnSurfaceVariant}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Classes="card" Padding="10,6" Margin="4"
                                IsVisible="{Binding HasBlockingChain}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding BlockingChainText}" FontSize="11" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding BlockingChain}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:BlockingChainLink">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,1">
                                                <TextBlock Text="{Binding SessionId, StringFormat='spid {0}'}"
                                                           FontSize="11" FontWeight="Bold" Width="70" />
                                                <TextBlock Grid.Column="1" FontSize="11" Width="130" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Database}"
                                                           Text="{Binding Database, StringFormat='db {0}'}" />
                                                <TextBlock Grid.Column="2" FontSize="11" Width="150" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Login}" Text="{Binding Login}" />
                                                <TextBlock Grid.Column="3" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Statement}" Text="{Binding Statement}" />
                                                <TextBlock Grid.Column="4" FontSize="11" Foreground="{StaticResource Amber}"
                                                           Text="{Binding WaitType}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DataGrid Grid.Row="2" Margin="4,0,4,4" ItemsSource="{Binding FilteredProcesses}"
                                  AutoGenerateColumns="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
                                  IsReadOnly="True" GridLinesVisibility="All" FontSize="12"
                                  SelectionMode="Single" SelectedItem="{Binding SelectedProcess}">
                            <DataGrid.Styles>
                                <Style Selector="DataGridRow">
                                    <Setter Property="Background" Value="{Binding RowBackground}" />
                                </Style>
                            </DataGrid.Styles>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" Width="64" />
                                <DataGridTextColumn Header="Blocked By" Binding="{Binding BlockedByText}" Width="78" />
                                <DataGridTextColumn Header="DB" Binding="{Binding Database}" Width="100" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="82" />
                                <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="110" />
                                <DataGridTextColumn Header="Wait Type" Binding="{Binding WaitType}" Width="130" />
                                <DataGridTextColumn Header="Wait ms" Binding="{Binding WaitMs, StringFormat='{}{0:N0}'}" Width="80" />
                                <DataGridTextColumn Header="Elapsed ms" Binding="{Binding ElapsedMs, StringFormat='{}{0:N0}'}" Width="90" />
                                <DataGridTextColumn Header="CPU ms" Binding="{Binding CpuMs, StringFormat='{}{0:N0}'}" Width="80" />
                                <DataGridTextColumn Header="Logical Reads" Binding="{Binding LogicalReads, StringFormat='{}{0:N0}'}" Width="100" />
                                <DataGridTextColumn Header="Physical Reads" Binding="{Binding Reads, StringFormat='{}{0:N0}'}" Width="100" />
                                <DataGridTextColumn Header="Writes" Binding="{Binding Writes, StringFormat='{}{0:N0}'}" Width="76" />
                                <DataGridTextColumn Header="Memory KB" Binding="{Binding GrantedMemoryKb, StringFormat='{}{0:N0}'}" Width="90" />
                                <DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="140" />
                                <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="110" />
                                <DataGridTextColumn Header="Program" Binding="{Binding Program}" Width="160" />
                                <DataGridTextColumn Header="Statement" Binding="{Binding Statement}" Width="520" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ══ RESOURCE WAITS ══ -->
                <TabItem Header="Resource Waits">
                    <Grid Margin="4" RowDefinitions="Auto,*">
                        <Border Classes="card" Padding="10,6" Margin="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Top" VerticalAlignment="Center" FontSize="12" />
                                <controls:SearchableComboBox Width="90" ItemsSource="{Binding WaitTopOptions}" SelectedItem="{Binding WaitTop}" />
                                <TextBlock Text="{Binding WaitsSummaryText}" FontSize="11"
                                           Foreground="{StaticResource OnSurfaceVariant}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <DataGrid Grid.Row="1" Margin="4,0,4,4" ItemsSource="{Binding Waits}"
                                  AutoGenerateColumns="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
                                  IsReadOnly="True" GridLinesVisibility="All" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Wait Type" Binding="{Binding WaitType}" Width="240" />
                                <DataGridTextColumn Header="Wait (s)" Binding="{Binding WaitSeconds, StringFormat='{}{0:N0}'}" Width="110" />
                                <DataGridTemplateColumn Header="Share" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Border HorizontalAlignment="Left" MinWidth="3" MaxWidth="214"
                                                        Background="{StaticResource Primary500}" Opacity="0.5"
                                                        Height="10" CornerRadius="3"
                                                        Width="{Binding SharePercent}" />
                                                <TextBlock Text="{Binding SharePercent, StringFormat='{}{0:0.#}%'}"
                                                           FontSize="10" Margin="4,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Signal (s)" Binding="{Binding SignalSeconds, StringFormat='{}{0:N0}'}" Width="110" />
                                <DataGridTextColumn Header="Waiting Tasks" Binding="{Binding WaitingTasks, StringFormat='{}{0:N0}'}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ══ EXPENSIVE QUERIES ══ -->
                <TabItem Header="Expensive Queries">
                    <Grid Margin="4" RowDefinitions="Auto,*">
                        <Border Classes="card" Padding="10,6" Margin="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Rank by" VerticalAlignment="Center" FontSize="12" />
                                <controls:SearchableComboBox MinWidth="150" ItemsSource="{Binding ExpensiveSortOptions}" SelectedIndex="{Binding ExpensiveSortIndex}" />
                                <TextBlock Text="Top" VerticalAlignment="Center" FontSize="12" />
                                <controls:SearchableComboBox Width="90" ItemsSource="{Binding ExpensiveTopOptions}" SelectedItem="{Binding ExpensiveTop}" />
                                <TextBlock Text="{Binding ExpensiveSummaryText}" FontSize="11"
                                           Foreground="{StaticResource OnSurfaceVariant}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <DataGrid Grid.Row="1" Margin="4,0,4,4" ItemsSource="{Binding ExpensiveQueries}"
                                  AutoGenerateColumns="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
                                  IsReadOnly="True" GridLinesVisibility="All" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Statement" Binding="{Binding Statement}" Width="620" />
                                <DataGridTextColumn Header="DB" Binding="{Binding Database}" Width="100" />
                                <DataGridTextColumn Header="Executions" Binding="{Binding ExecutionCount, StringFormat='{}{0:N0}'}" Width="100" />
                                <DataGridTextColumn Header="Avg CPU ms" Binding="{Binding AvgCpuMs, StringFormat='{}{0:N0}'}" Width="100" />
                                <DataGridTextColumn Header="Total CPU ms" Binding="{Binding TotalCpuMs, StringFormat='{}{0:N0}'}" Width="110" />
                                <DataGridTextColumn Header="Avg Elapsed ms" Binding="{Binding AvgElapsedMs, StringFormat='{}{0:N0}'}" Width="110" />
                                <DataGridTextColumn Header="Total Elapsed ms" Binding="{Binding TotalElapsedMs, StringFormat='{}{0:N0}'}" Width="120" />
                                <DataGridTextColumn Header="Avg Reads" Binding="{Binding AvgReads, StringFormat='{}{0:N0}'}" Width="100" />
                                <DataGridTextColumn Header="Total Reads" Binding="{Binding TotalReads, StringFormat='{}{0:N0}'}" Width="110" />
                                <DataGridTextColumn Header="Last Executed" Binding="{Binding LastExecution, StringFormat='{}{0:MM-dd HH:mm:ss}'}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ══ DEADLOCKS ══ -->
                <TabItem Header="Deadlocks">
                    <Grid Margin="4" RowDefinitions="Auto,*">
                        <Border Classes="card" Padding="10,6" Margin="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Classes="secondary" Command="{Binding RefreshDeadlocksCommand}" Padding="12,5" FontSize="12">
                                    <TextBlock Text="⟳ Refresh deadlocks" />
                                </Button>
                                <TextBlock Text="{Binding DeadlocksSummaryText}" FontSize="11"
                                           Foreground="{StaticResource OnSurfaceVariant}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1" Margin="4,0,4,4" ColumnDefinitions="300,*,*">
                            <Border Classes="card" Padding="0">
                                <ListBox ItemsSource="{Binding Deadlocks}" SelectedItem="{Binding SelectedDeadlock}"
                                         FontSize="11" Padding="2">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="models:HealthDeadlockReport">
                                            <StackPanel Margin="4,3">
                                                <TextBlock Text="{Binding ListTitle}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding ListSubtitle}" FontSize="10"
                                                           Foreground="{StaticResource OnSurfaceVariant}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <Grid Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" IsVisible="{Binding HasSelectedDeadlock}">
                                <Grid RowDefinitions="*,Auto">
                                    <DataGrid ItemsSource="{Binding SelectedDeadlock.Processes}"
                                              AutoGenerateColumns="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
                                              IsReadOnly="True" GridLinesVisibility="All" FontSize="12">
                                        <DataGrid.Styles>
                                            <Style Selector="DataGridRow">
                                                <Setter Property="Background" Value="{Binding RowBackground}" />
                                            </Style>
                                        </DataGrid.Styles>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="SPID" Binding="{Binding Spid}" Width="60" />
                                            <DataGridTextColumn Header="Victim" Binding="{Binding VictimText}" Width="70" />
                                            <DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="150" />
                                            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="110" />
                                            <DataGridTextColumn Header="App" Binding="{Binding App}" Width="150" />
                                            <DataGridTextColumn Header="Wait Resource" Binding="{Binding WaitResource}" Width="220" />
                                            <DataGridTextColumn Header="Wait ms" Binding="{Binding WaitMs}" Width="80" />
                                            <DataGridTextColumn Header="Mode" Binding="{Binding LockMode}" Width="70" />
                                            <DataGridTextColumn Header="Statement" Binding="{Binding Statement}" Width="480" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Expander Grid.Row="1" Header="Victim batch (input buffer)" FontSize="12" IsExpanded="False">
                                        <TextBox Classes="codeBox" IsReadOnly="True" MaxHeight="140"
                                                 Text="{Binding SelectedDeadlock.VictimInputBuf}" TextWrapping="Wrap" />
                                    </Expander>
                                </Grid>
                            </Grid>
                            <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsVisible="{Binding !HasSelectedDeadlock}" Spacing="6">
                                <TextBlock Text="🕊" FontSize="36" HorizontalAlignment="Center" />
                                <TextBlock Text="No deadlocks recorded in the system_health ring buffer."
                                           FontSize="13" Foreground="{StaticResource OnSurfaceVariant}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ══ DATA FILE I/O ══ -->
                <TabItem Header="Data File I/O">
                    <Grid Margin="4" RowDefinitions="Auto,*">
                        <Border Classes="card" Padding="10,6" Margin="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Database" VerticalAlignment="Center" FontSize="12" />
                                <controls:SearchableComboBox MinWidth="200" ItemsSource="{Binding DatabaseOptions}" SelectedItem="{Binding FileIoDatabaseFilter}" />
                                <TextBlock Text="{Binding FileIoSummaryText}" FontSize="11"
                                           Foreground="{StaticResource OnSurfaceVariant}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <DataGrid Grid.Row="1" Margin="4,0,4,4" ItemsSource="{Binding FileIo}"
                                  AutoGenerateColumns="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
                                  IsReadOnly="True" GridLinesVisibility="All" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="150" />
                                <DataGridTextColumn Header="File" Binding="{Binding File}" Width="180" />
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeDesc}" Width="110" />
                                <DataGridTextColumn Header="Size MB" Binding="{Binding SizeMb, StringFormat='{}{0:N0}'}" Width="100" />
                                <DataGridTextColumn Header="Reads" Binding="{Binding NumOfReads, StringFormat='{}{0:N0}'}" Width="120" />
                                <DataGridTextColumn Header="Writes" Binding="{Binding NumOfWrites, StringFormat='{}{0:N0}'}" Width="120" />
                                <DataGridTextColumn Header="Read Stall (s)" Binding="{Binding ReadStallSec, StringFormat='{}{0:N0}'}" Width="110" />
                                <DataGridTextColumn Header="Write Stall (s)" Binding="{Binding WriteStallSec, StringFormat='{}{0:N0}'}" Width="110" />
                                <DataGridTextColumn Header="Avg Stall ms" Binding="{Binding AvgStallMs, StringFormat='{}{0:0.#}'}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ══ MISSING INDEXES ══ -->
                <TabItem Header="Missing Indexes">
                    <Grid Margin="4" RowDefinitions="Auto,*">
                        <Border Classes="card" Padding="10,6" Margin="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Database" VerticalAlignment="Center" FontSize="12" />
                                <controls:SearchableComboBox MinWidth="200" ItemsSource="{Binding DatabaseOptions}" SelectedItem="{Binding MissingDatabaseFilter}" />
                                <Button Classes="secondary" Command="{Binding CopyMissingIndexScriptCommand}" Padding="12,5" FontSize="12"
                                        IsVisible="{Binding HasSelectedMissingIndex}"
                                        ToolTip.Tip="Copy a CREATE NONCLUSTERED INDEX script for the selected recommendation">
                                    <TextBlock Text="⧉ Copy CREATE INDEX script" />
                                </Button>
                                <TextBlock Text="{Binding MissingSummaryText}" FontSize="11"
                                           Foreground="{StaticResource OnSurfaceVariant}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <DataGrid Grid.Row="1" Margin="4,0,4,4" ItemsSource="{Binding MissingIndexes}"
                                  AutoGenerateColumns="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
                                  IsReadOnly="True" GridLinesVisibility="All" FontSize="12"
                                  SelectionMode="Single" SelectedItem="{Binding SelectedMissingIndex}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Impact" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ImpactText}" Foreground="{Binding ImpactBrush}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Effective Score" Binding="{Binding EffectiveText}" Width="130" />
                                <DataGridTextColumn Header="DB" Binding="{Binding Database}" Width="130" />
                                <DataGridTextColumn Header="Schema" Binding="{Binding Schema}" Width="90" />
                                <DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="180" />
                                <DataGridTextColumn Header="Key Columns" Binding="{Binding KeyColumns}" Width="260" />
                                <DataGridTextColumn Header="Include Columns" Binding="{Binding IncludedColumns}" Width="220" />
                                <DataGridTextColumn Header="Seeks" Binding="{Binding UserSeeks, StringFormat='{}{0:N0}'}" Width="90" />
                                <DataGridTextColumn Header="Scans" Binding="{Binding UserScans, StringFormat='{}{0:N0}'}" Width="90" />
                                <DataGridTextColumn Header="Compiles" Binding="{Binding UniqueCompiles, StringFormat='{}{0:N0}'}" Width="90" />
                                <DataGridTextColumn Header="Avg Cost" Binding="{Binding AvgUserCost, StringFormat='{}{0:N0}'}" Width="100" />
                                <DataGridTextColumn Header="Last Seek" Binding="{Binding LastUserSeekUtc, StringFormat='{}{0:MM-dd HH:mm}'}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ══ QUERY STORE ══ -->
                <TabItem Header="Query Store">
                    <Grid Margin="4" RowDefinitions="Auto,Auto,*,190">
                        <Border Classes="card" Padding="10,6" Margin="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Database" VerticalAlignment="Center" FontSize="12" />
                                <controls:SearchableComboBox MinWidth="180" ItemsSource="{Binding DatabaseOptions}"
                                                             SelectedItem="{Binding QueryStoreDatabase}"
                                                             ToolTip.Tip="Query Store is per-database; leave the filter blank to use the connection's own database" />
                                <TextBlock Text="Window" VerticalAlignment="Center" FontSize="12" />
                                <controls:SearchableComboBox Width="96" ItemsSource="{Binding QueryStoreWindowOptions}"
                                                             SelectedItem="{Binding QueryStoreWindowHours}"
                                                             ToolTip.Tip="Hours of history to look at" />
                                <TextBlock Text="Rank by" VerticalAlignment="Center" FontSize="12" />
                                <controls:SearchableComboBox Width="130" ItemsSource="{Binding QueryStoreRankOptions}"
                                                             SelectedIndex="{Binding QueryStoreRankIndex}"
                                                             ToolTip.Tip="Which resource the top-queries grid is ordered by" />
                                <TextBlock Text="Regressed by ≥" VerticalAlignment="Center" FontSize="12" />
                                <controls:SearchableComboBox Width="72" ItemsSource="{Binding QueryStoreChangeOptions}"
                                                             SelectedItem="{Binding QueryStoreMinChange}"
                                                             ToolTip.Tip="How much slower the second half of the window has to be before a query counts as regressed" />
                                <Button Classes="secondary" Command="{Binding LoadQueryStoreCommand}" Padding="12,5" FontSize="12"
                                        ToolTip.Tip="Read the options, the regressed queries and the top queries">
                                    <TextBlock Text="⟳ Load Query Store" />
                                </Button>
                                <Button Classes="secondary" Command="{Binding EnableQueryStoreCommand}" Padding="12,5" FontSize="12"
                                        ToolTip.Tip="Script ALTER DATABASE … SET QUERY_STORE = ON and ask before running it">
                                    <TextBlock Text="⚡ Enable…" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Grid.Row="1" Padding="10,6" Margin="4">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding QueryStoreStateText}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource OnSurfaceVariant}" />
                                <TextBlock Text="{Binding QueryStoreSummaryText}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- One report per row: side by side every numeric header lost its
                             tail at the app's usual UI scale. -->
                        <Grid Grid.Row="2" Margin="4,0,4,4" RowDefinitions="Auto,1*,Auto,1*">
                            <TextBlock Grid.Row="0" Text="Regressed queries (first half of the window → second half)"
                                       FontSize="12" FontWeight="SemiBold" Margin="4,2" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding QueryStoreRegressed}"
                                      AutoGenerateColumns="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
                                      IsReadOnly="True" GridLinesVisibility="All" FontSize="12" MaxHeight="220"
                                      SelectionMode="Single" SelectedItem="{Binding SelectedRegressed}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Change" Binding="{Binding ChangeText}" Width="84" />
                                    <DataGridTextColumn Header="Query" Binding="{Binding OneLineQuery}" Width="*" MinWidth="240" />
                                    <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="130" />
                                    <DataGridTextColumn Header="Avg duration" Binding="{Binding DurationText}" Width="155" />
                                    <DataGridTextColumn Header="Avg CPU" Binding="{Binding CpuText}" Width="135" />
                                    <DataGridTextColumn Header="Reads" Binding="{Binding ReadsText}" Width="120" />
                                    <DataGridTextColumn Header="Execs" Binding="{Binding AfterExecutions, StringFormat='{}{0:N0}'}" Width="82" />
                                    <DataGridTextColumn Header="Query Id" Binding="{Binding QueryId}" Width="84" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" Text="Top queries in the window"
                                       FontSize="12" FontWeight="SemiBold" Margin="4,6,4,2" />
                            <DataGrid Grid.Row="3" ItemsSource="{Binding QueryStoreTop}"
                                      AutoGenerateColumns="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
                                      IsReadOnly="True" GridLinesVisibility="All" FontSize="12"
                                      SelectionMode="Single" SelectedItem="{Binding SelectedTop}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Query" Binding="{Binding OneLineQuery}" Width="*" MinWidth="240" />
                                    <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="130" />
                                    <DataGridTextColumn Header="Total ms" Binding="{Binding TotalMs, StringFormat='{}{0:N0}'}" Width="92" />
                                    <DataGridTextColumn Header="Avg ms" Binding="{Binding AvgMs, StringFormat='{}{0:N1}'}" Width="88" />
                                    <DataGridTextColumn Header="Avg CPU" Binding="{Binding AvgCpuMs, StringFormat='{}{0:N1}'}" Width="92" />
                                    <DataGridTextColumn Header="Execs" Binding="{Binding Executions, StringFormat='{}{0:N0}'}" Width="82" />
                                    <DataGridTextColumn Header="Reads" Binding="{Binding AvgReads, StringFormat='{}{0:N0}'}" Width="82" />
                                    <DataGridTextColumn Header="Query Id" Binding="{Binding QueryId}" Width="84" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid Grid.Row="3" Margin="4,0,4,4" ColumnDefinitions="2*,*">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                    <TextBlock Text="Plans of the selected query" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Classes="secondary" Command="{Binding ForcePlanCommand}" Padding="10,4" FontSize="12"
                                            ToolTip.Tip="Pin the selected plan to this query (sys.sp_query_store_force_plan) — asks first">
                                        <TextBlock Text="📌 Force plan" />
                                    </Button>
                                    <Button Classes="secondary" Command="{Binding UnforcePlanCommand}" Padding="10,4" FontSize="12"
                                            ToolTip.Tip="Release the pinned plan (sys.sp_query_store_unforce_plan) — asks first">
                                        <TextBlock Text="✂ Unforce" />
                                    </Button>
                                </StackPanel>
                                <Panel Grid.Row="1">
                                    <DataGrid ItemsSource="{Binding QueryStorePlans}"
                                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All"
                                              FontSize="12" SelectionMode="Single" SelectedItem="{Binding SelectedPlan}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Plan" Binding="{Binding PlanId}" Width="76" />
                                            <DataGridTextColumn Header="Avg ms" Binding="{Binding AvgMs, StringFormat='{}{0:N1}'}" Width="90" />
                                            <DataGridTextColumn Header="Execs" Binding="{Binding Executions, StringFormat='{}{0:N0}'}" Width="82" />
                                            <DataGridTextColumn Header="Compiles" Binding="{Binding Compiles, StringFormat='{}{0:N0}'}" Width="96" />
                                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedUtc, StringFormat='{}{0:MM-dd HH:mm}'}" Width="125" />
                                            <DataGridTextColumn Header="Last run" Binding="{Binding LastExecutedUtc, StringFormat='{}{0:MM-dd HH:mm}'}" Width="125" />
                                            <DataGridTextColumn Header="Forcing" Binding="{Binding StatusText}" Width="*" MinWidth="170" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Select a query above to see the plans it has and which one is pinned."
                                               IsVisible="{Binding !HasQueryStorePlans}" FontSize="12"
                                               Foreground="{StaticResource OnSurfaceVariant}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                            </Grid>
                            <Border Classes="card" Grid.Column="1" Padding="8" Margin="8,0,0,0">
                                <Grid RowDefinitions="Auto,*">
                                    <TextBlock Grid.Row="0" Text="Query text as Query Store captured it" FontSize="12"
                                               FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Grid.Row="1" Classes="codeBox" IsReadOnly="True"
                                             Text="{Binding QueryStoreQueryText}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ══ ERROR LOG ══ -->
                <TabItem Header="Error Log">
                    <Grid Margin="4" RowDefinitions="Auto,*">
                        <Border Classes="card" Padding="10,6" Margin="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Classes="secondary" Command="{Binding LoadErrorLogCommand}" Padding="12,5" FontSize="12"
                                        ToolTip.Tip="Read the newest records from the SQL Server error log (xp_readerrorlog)">
                                    <TextBlock Text="⟳ Load error log" />
                                </Button>
                                <TextBlock Text="Newest" VerticalAlignment="Center" FontSize="12" />
                                <controls:SearchableComboBox Width="90" ItemsSource="{Binding ErrorLogTailOptions}"
                                                             SelectedItem="{Binding ErrorLogTail}"
                                                             ToolTip.Tip="How many of the newest records to read" />
                                <TextBox Width="220" Text="{Binding ErrorLogFilter}"
                                         PlaceholderText="Contains… (applied when loading)" />
                                <CheckBox Content="Severity 11+" IsChecked="{Binding ErrorLogOnlyErrors}"
                                          ToolTip.Tip="Hide informational and login records" />
                                <TextBlock Text="{Binding ErrorLogSummaryText}" FontSize="11"
                                           Foreground="{StaticResource OnSurfaceVariant}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420"
                                           ToolTip.Tip="{Binding ErrorLogSummaryText}" />
                            </StackPanel>
                        </Border>
                        <DataGrid Grid.Row="1" Margin="4,0,4,4" ItemsSource="{Binding ErrorLog}"
                                  AutoGenerateColumns="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
                                  IsReadOnly="True" GridLinesVisibility="All" FontSize="12"
                                  SelectionMode="Single">
                            <DataGrid.Styles>
                                <Style Selector="DataGridRow">
                                    <Setter Property="Background" Value="{Binding RowBackground}" />
                                </Style>
                            </DataGrid.Styles>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="150" />
                                <DataGridTextColumn Header="Sev" Binding="{Binding SeverityText}" Width="50" />
                                <DataGridTextColumn Header="Error" Binding="{Binding ErrorNumber}" Width="80" />
                                <DataGridTextColumn Header="Source" Binding="{Binding ProcessInfo}" Width="130" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Text}" Width="900" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- ═══════════ STATUS BAR ═══════════ -->
            <Border Grid.Row="3" Background="{StaticResource SubtleHeader}" Padding="12,6" Margin="0,8,0,0" CornerRadius="4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="{StaticResource PrimaryText}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="link" Command="{Binding CopyErrorCommand}" Padding="8,2" FontSize="11"
                            IsVisible="{Binding ShowError}"><TextBlock Text="Copy error" /></Button>
                </Grid>
            </Border>

            <!-- Error banner -->
            <Border Grid.Row="1" Background="{StaticResource ErrorPanelBg}"
                    BorderBrush="{StaticResource ErrorPanelBorder}" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,8,0,0"
                    VerticalAlignment="Top" ZIndex="50"
                    IsVisible="{Binding ShowError}">
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                           Foreground="{StaticResource ErrorPanelText}" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </LayoutTransformControl>
</Window>
