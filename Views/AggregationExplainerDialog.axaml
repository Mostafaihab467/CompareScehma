<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SchemaCompare.Controls"
        x:Class="SchemaCompare.Views.AggregationExplainerDialog"
        Title="✨ SQL Keyword Explainer"
        Width="620" Height="560" MinWidth="520" MinHeight="440"
        CanResize="True" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}"
        FontFamily="Segoe UI">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

        <!-- Legendary header: gold gradient banner -->
        <Border CornerRadius="12" Padding="18,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#3A2A08" Offset="0" />
                    <GradientStop Color="#1E1B2E" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border BorderBrush="#E8A93D" BorderThickness="1.4" CornerRadius="9" Padding="16,12"
                    Background="#22E8A93D">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="✨" FontSize="38" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="KeywordText" FontSize="26" FontWeight="Bold"
                                   Foreground="#F7D774" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Border Background="#33F7D774" CornerRadius="4" Padding="8,2">
                                <TextBlock x:Name="CategoryText" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#F7D774" />
                            </Border>
                            <TextBlock Text="from the ✨ Explain library" FontSize="11"
                                       Foreground="#B9A26A" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- What it does -->
        <Border Grid.Row="1" Classes="card" Padding="14" Margin="0,10,0,0">
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource Primary500}" />
                <TextBlock x:Name="ExplanationText" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource PrimaryText}" LineHeight="20" />
            </StackPanel>
        </Border>

        <!-- Example + tip -->
        <Grid Grid.Row="2" RowDefinitions="*,Auto" Margin="0,10,0,0">
            <Border Classes="card" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Border Background="{StaticResource SubtleHeader}" Padding="12,6">
                        <TextBlock Text="Example T-SQL" FontWeight="Bold" FontSize="12" />
                    </Border>
                    <controls:SqlHighlightedEditor x:Name="ExampleBox" Grid.Row="1"
                                                   IsReadOnly="True" EnableLint="False" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource InputBackground}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="💡" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock x:Name="TipsText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource OnSurfaceVariant}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Prev / next / close -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button x:Name="PrevBtn" Classes="secondary" Padding="14,7" FontSize="12">
                <TextBlock Text="◂ Previous" />
            </Button>
            <Button x:Name="NextBtn" Classes="secondary" Padding="14,7" FontSize="12">
                <TextBlock Text="Next ▸" />
            </Button>
            <Button x:Name="CloseBtn" Classes="legendary" Padding="18,7" FontSize="12">
                <TextBlock Text="✨ Got it!" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
