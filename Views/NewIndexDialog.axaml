<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SchemaCompare.Controls"
        x:Class="SchemaCompare.Views.NewIndexDialog"
        Title="New Index"
        Width="820" Height="640" MinWidth="680" MinHeight="520"
        CanResize="True" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14">

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="🗃" FontSize="20" VerticalAlignment="Center" />
            <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Basic options -->
        <Border Grid.Row="1" Classes="card" Padding="12,10">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto,190,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="Index name:" VerticalAlignment="Center" FontSize="12" />
                    <TextBox x:Name="NameBox" Grid.Column="1" Watermark="IDX_Table" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="Type:" VerticalAlignment="Center" FontSize="12" />
                    <controls:SearchableComboBox x:Name="TypeBox" Grid.Column="3" SelectedIndex="0" FontSize="12">
                        <ComboBoxItem Content="Nonclustered" />
                        <ComboBoxItem Content="Clustered" />
                        <ComboBoxItem Content="Nonclustered Columnstore" />
                        <ComboBoxItem Content="Clustered Columnstore" />
                    </controls:SearchableComboBox>
                    <CheckBox x:Name="UniqueCheck" Grid.Column="4" Content="Unique" VerticalAlignment="Center" FontSize="12" />
                </Grid>

                <Grid ColumnDefinitions="Auto,Auto,110,Auto" ColumnSpacing="8">
                    <TextBlock Text="Key columns" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Included columns" FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Text="" />
                    <TextBlock Grid.Column="3" Text="" />
                </Grid>

                <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,*,Auto">
                    <!-- Key columns -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <controls:SearchableComboBox x:Name="KeyAvailBox" FontSize="12" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" x:Name="AddKeyBtn" Classes="secondary" Padding="10,4" FontSize="12">
                            <TextBlock Text="+ Add" />
                        </Button>
                    </Grid>
                    <ListBox x:Name="KeyList" Grid.Row="1" MinHeight="120" MaxHeight="150" FontSize="12" Margin="0,6" />

                    <!-- Included columns -->
                    <Grid Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <controls:SearchableComboBox x:Name="IncAvailBox" FontSize="12" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" x:Name="AddIncBtn" Classes="secondary" Padding="10,4" FontSize="12">
                            <TextBlock Text="+ Add" />
                        </Button>
                    </Grid>
                    <ListBox x:Name="IncList" Grid.Row="1" Grid.Column="2" MinHeight="120" MaxHeight="150" FontSize="12" Margin="0,6" />

                    <!-- Key list controls -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="KeyUpBtn" Classes="secondary" Padding="8,3" FontSize="11"><TextBlock Text="↑ Up" /></Button>
                        <Button x:Name="KeyDownBtn" Classes="secondary" Padding="8,3" FontSize="11"><TextBlock Text="↓ Down" /></Button>
                        <Button x:Name="KeyRemoveBtn" Classes="danger" Padding="8,3" FontSize="11"><TextBlock Text="✕ Remove" /></Button>
                    </StackPanel>
                    <!-- Include list controls -->
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="IncRemoveBtn" Classes="danger" Padding="8,3" FontSize="11"><TextBlock Text="✕ Remove" /></Button>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto,90" ColumnSpacing="8">
                    <TextBlock Text="Filter (WHERE):" VerticalAlignment="Center" FontSize="12" />
                    <TextBox x:Name="FilterBox" Grid.Column="1" Watermark="e.g. IsActive = 1" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="Fill factor:" VerticalAlignment="Center" FontSize="12" />
                    <TextBox x:Name="FillFactorBox" Grid.Column="3" Text="0" Watermark="0 = server default" FontSize="12" />
                </Grid>

                <TextBlock x:Name="NoteText" FontSize="11" Foreground="{StaticResource WarningPanelText}"
                           TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>
        </Border>

        <!-- Script preview -->
        <Border Grid.Row="2" Classes="card" Padding="0" Margin="0,8,0,0">
            <Grid RowDefinitions="Auto,*">
                <Border Background="{StaticResource SubtleHeader}" Padding="10,6">
                    <TextBlock Text="T-SQL preview" FontWeight="Bold" FontSize="12" />
                </Border>
                <controls:SqlHighlightedEditor x:Name="Preview" Grid.Row="1" IsReadOnly="True" EnableLint="False" />
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button x:Name="CancelBtn" Padding="14,7" FontSize="12">
                <TextBlock Text="Cancel" />
            </Button>
            <Button x:Name="ScriptBtn" Classes="secondary" Padding="14,7" FontSize="12">
                <TextBlock Text="📄  Script to Definition Tab" />
            </Button>
            <Button x:Name="ExecuteBtn" Classes="primary" Padding="14,7" FontSize="12">
                <TextBlock Text="▶  Execute" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
