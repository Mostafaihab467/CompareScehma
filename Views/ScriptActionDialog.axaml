<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SchemaCompare.Controls"
        x:Class="SchemaCompare.Views.ScriptActionDialog"
        Title="Confirm script"
        Width="680" Height="480" MinWidth="520" MinHeight="360"
        CanResize="True" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14">

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1" x:Name="WarningPanel" Background="{StaticResource WarningPanelBg}"
                BorderBrush="{StaticResource WarningPanelBorder}" BorderThickness="1"
                CornerRadius="6" Padding="10,6" Margin="0,8,0,0" IsVisible="False">
            <TextBlock x:Name="WarningText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource WarningPanelText}" />
        </Border>

        <Border Grid.Row="2" Classes="card" Padding="0" Margin="0,8,0,0">
            <controls:SqlHighlightedEditor x:Name="ScriptBox" IsReadOnly="True" EnableLint="False" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button x:Name="CancelBtn" Padding="14,7" FontSize="12">
                <TextBlock Text="Cancel" />
            </Button>
            <Button x:Name="ExecuteBtn" Classes="primary" Padding="14,7" FontSize="12">
                <TextBlock Text="▶  Execute against database" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
