<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SchemaCompare.Controls.DiagramTableCard"
             Width="240">
    <UserControl.Styles>
        <Style Selector="TextBlock.icon">
            <Setter Property="Foreground" Value="#71717A" />
        </Style>
        <Style Selector="TextBlock.icon.fk">
            <Setter Property="Foreground" Value="#7DD3FC" />
        </Style>
        <Style Selector="TextBlock.icon.pk">
            <Setter Property="Foreground" Value="#FBBF24" />
        </Style>
    </UserControl.Styles>
    <Border Background="#181824" BorderBrush="#3A3A55" BorderThickness="1" CornerRadius="10"
            BoxShadow="0 4 14 0 #80000000">
        <StackPanel>
            <Border Background="#23233A" CornerRadius="10,10,0,0" Padding="10,8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="{DynamicResource F12p5}"
                                   Foreground="#F2F2F7" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding HeaderSubtitle}" FontSize="{DynamicResource F10p5}" Margin="0,2,0,0"
                                   Foreground="#B9B9CE" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0">
                        <Button x:Name="IsolateButton" Background="Transparent" BorderThickness="0"
                                Padding="5,2" FontSize="{DynamicResource F13}" Cursor="Hand"
                                ToolTip.Tip="Show only this table's relations (click again to show all)">
                            <TextBlock Text="🔗" />
                        </Button>
                        <Button x:Name="FocusButton" Background="Transparent" BorderThickness="0"
                                Padding="5,2" FontSize="{DynamicResource F13}" Cursor="Hand"
                                ToolTip.Tip="Center this table in view">
                            <TextBlock Text="⌖" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding VisibleColumns}" Margin="4,4,4,2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,2">
                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="{DynamicResource F11}" Width="20"
                                       Classes="icon"
                                       Classes.pk="{Binding IsPrimaryKey}"
                                       Classes.fk="{Binding IsForeignKey}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource F11p5}"
                                       Foreground="#E4E4EF" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding DisplayType}" FontSize="{DynamicResource F10}"
                                       Foreground="#8E8EA3" Margin="6,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding OverflowText}" IsVisible="{Binding HasOverflow}"
                       FontSize="{DynamicResource F10}" FontStyle="Italic" Foreground="#8E8EA3"
                       Margin="10,0,10,8" />
        </StackPanel>
    </Border>
</UserControl>
