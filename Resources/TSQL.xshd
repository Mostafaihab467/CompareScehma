      <Word>PARTITION</Word>
      <Word>PERCENT</Word>
      <Word>PIVOT</Word>
      <Word>PLAN</Word>
      <Word>PRIMARY</Word>
      <Word>PRINT</Word>
      <Word>PROC</Word>
      <Word>PROCEDURE</Word>
      <Word>RAISERROR</Word>
      <Word>READ</Word>
      <Word>READCOMMITTED</Word>
      <Word>READPAST</Word>
      <Word>READUNCOMMITTED</Word>
      <Word>RECOMPILE</Word>
      <Word>REFERENCES</Word>
      <Word>REPEATABLE</Word>
      <Word>REPEATABLEREAD</Word>
