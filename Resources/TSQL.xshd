<?xml version="1.0"?>
<SyntaxDefinition name="TSQL" extensions=".sql"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A9955" fontStyle="italic" />
  <Color name="String" foreground="#CE9178" />
  <Color name="Number" foreground="#B5CEA8" />
  <Color name="Keyword" foreground="#569CD6" fontWeight="bold" />
  <Color name="Function" foreground="#DCDCAA" />
  <Color name="SystemFunc" foreground="#C586C0" />
  <Color name="Type" foreground="#4EC9B0" />
  <Color name="Variable" foreground="#9CDCFE" />
  <Color name="Bracketed" foreground="#E6E6F2" />
  <Color name="Operator" foreground="#D4D4D4" />

  <RuleSet ignoreCase="true">
    <!-- Block Comments -->
    <Span color="Comment" multiline="true">
      <Begin>/\*</Begin>
      <End>\*/</End>
    </Span>

    <!-- Line Comments -->
    <Span color="Comment">
      <Begin>--</Begin>
    </Span>

    <!-- String Literals (including Unicode N'...' and escaped '') -->
    <Span color="String" multiline="true">
      <Begin>N'</Begin>
      <End>'</End>
      <RuleSet>
        <Span begin="''" end="" />
      </RuleSet>
    </Span>
    <Span color="String" multiline="true">
      <Begin>'</Begin>
      <End>'</End>
      <RuleSet>
        <Span begin="''" end="" />
      </RuleSet>
    </Span>

    <!-- Bracketed Identifiers [schema].[table] -->
    <Rule color="Bracketed">\[[^\]]+\]</Rule>

    <!-- Numeric Literals -->
    <Rule color="Number">\b\d+(\.\d+)?\b</Rule>
    <Rule color="Number">\b0x[0-9A-Fa-f]+\b</Rule>

    <!-- Local Variables: @name -->
    <Rule color="Variable">@[A-Za-z_][A-Za-z0-9_]*</Rule>

    <!-- System Functions / Variables: @@name -->
    <Rule color="SystemFunc">@@[A-Za-z_][A-Za-z0-9_]*</Rule>

    <!-- Standard SQL / T-SQL Keywords -->
    <Keywords color="Keyword">
      <Word>ACTION</Word>
      <Word>ADD</Word>
      <Word>ALL</Word>
      <Word>ALTER</Word>
      <Word>AND</Word>
      <Word>ANY</Word>
      <Word>APPLY</Word>
      <Word>AS</Word>
      <Word>ASC</Word>
      <Word>AUTHORIZATION</Word>
      <Word>BACKUP</Word>
      <Word>BEGIN</Word>
      <Word>BETWEEN</Word>
      <Word>BREAK</Word>
      <Word>BULK</Word>
      <Word>BY</Word>
      <Word>CASCADE</Word>
      <Word>CASE</Word>
      <Word>CATCH</Word>
      <Word>CHECK</Word>
      <Word>CHECKPOINT</Word>
      <Word>CLOSE</Word>
      <Word>CLUSTERED</Word>
      <Word>COALESCE</Word>
      <Word>COLLATE</Word>
      <Word>COLUMN</Word>
      <Word>COMMIT</Word>
      <Word>CONSTRAINT</Word>
      <Word>CONTAINS</Word>
      <Word>CONTINUE</Word>
      <Word>CREATE</Word>
      <Word>CROSS</Word>
      <Word>CURRENT</Word>
      <Word>CURRENT_TIMESTAMP</Word>
      <Word>CURSOR</Word>
      <Word>DATABASE</Word>
      <Word>DEALLOCATE</Word>
      <Word>DECLARE</Word>
      <Word>DEFAULT</Word>
      <Word>DELAY</Word>
      <Word>DELETE</Word>
      <Word>DESC</Word>
      <Word>DISABLE</Word>
      <Word>DISTINCT</Word>
      <Word>DROP</Word>
      <Word>ELSE</Word>
      <Word>ENABLE</Word>
      <Word>END</Word>
      <Word>ESCAPE</Word>
      <Word>EXCEPT</Word>
      <Word>EXEC</Word>
      <Word>EXECUTE</Word>
      <Word>EXISTS</Word>
      <Word>EXIT</Word>
      <Word>EXTERNAL</Word>
      <Word>FETCH</Word>
      <Word>FILE</Word>
      <Word>FILLFACTOR</Word>
      <Word>FILTER</Word>
      <Word>FOR</Word>
      <Word>FORCE</Word>
      <Word>FOREIGN</Word>
      <Word>FROM</Word>
      <Word>FULL</Word>
      <Word>FUNCTION</Word>
      <Word>GO</Word>
