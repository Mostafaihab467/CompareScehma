      <Word>CHARINDEX</Word>
      <Word>CHECKSUM</Word>
      <Word>CHECKSUM_AGG</Word>
      <Word>CHOOSE</Word>
      <Word>COL_LENGTH</Word>
      <Word>COL_NAME</Word>
      <Word>COLUMNPROPERTY</Word>
      <Word>CONCAT</Word>
      <Word>CONCAT_WS</Word>
      <Word>CONVERT</Word>
      <Word>COS</Word>
      <Word>COT</Word>
