      <Word>TINYINT</Word>
      <Word>UNIQUEIDENTIFIER</Word>
      <Word>VARBINARY</Word>
      <Word>VARCHAR</Word>
      <Word>XML</Word>
    </Keywords>

    <!-- Built-in Functions -->
    <Keywords color="Function">
      <Word>ABS</Word>
      <Word>ACOS</Word>
      <Word>APPROX_COUNT_DISTINCT</Word>
      <Word>ASCII</Word>
      <Word>ASIN</Word>
      <Word>ATAN</Word>
      <Word>ATN2</Word>
      <Word>AVG</Word>
      <Word>CAST</Word>
      <Word>CEILING</Word>
