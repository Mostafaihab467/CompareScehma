      <Word>ROWS</Word>
      <Word>RULE</Word>
      <Word>SAVE</Word>
      <Word>SCHEMA</Word>
      <Word>SELECT</Word>
      <Word>SEQUENCE</Word>
      <Word>SERIALIZABLE</Word>
      <Word>SET</Word>
      <Word>SNAPSHOT</Word>
      <Word>SOME</Word>
      <Word>STATISTICS</Word>
      <Word>SYSTEM_VERSIONING</Word>
      <Word>TABLE</Word>
      <Word>TABLOCK</Word>
      <Word>TABLOCKX</Word>
      <Word>TARGET</Word>
      <Word>TEMPORAL</Word>
      <Word>THEN</Word>
      <Word>THROW</Word>
      <Word>TIES</Word>
      <Word>TIME</Word>
      <Word>TO</Word>
      <Word>TOP</Word>
      <Word>TRAN</Word>
      <Word>TRANSACTION</Word>
      <Word>TRIGGER</Word>
      <Word>TRUNCATE</Word>
      <Word>TRY</Word>
      <Word>TYPE</Word>
      <Word>UNCOMMITTED</Word>
      <Word>UNION</Word>
      <Word>UNIQUE</Word>
      <Word>UNPIVOT</Word>
      <Word>UPDLOCK</Word>
      <Word>UPDATE</Word>
      <Word>UPDATETEXT</Word>
      <Word>USE</Word>
      <Word>USER</Word>
      <Word>VALUES</Word>
      <Word>VARYING</Word>
      <Word>VIEW</Word>
      <Word>WAITFOR</Word>
      <Word>WHEN</Word>
      <Word>WHERE</Word>
      <Word>WHILE</Word>
      <Word>WITH</Word>
      <Word>WITHIN</Word>
      <Word>WRITETEXT</Word>
      <Word>XLOCK</Word>
    </Keywords>

    <!-- Data Types -->
    <Keywords color="Type">
      <Word>BIGINT</Word>
      <Word>BINARY</Word>
      <Word>BIT</Word>
      <Word>CHAR</Word>
      <Word>DATE</Word>
      <Word>DATETIME</Word>
