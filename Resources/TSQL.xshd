      <Word>NULL</Word>
      <Word>NULLIF</Word>
      <Word>OFF</Word>
      <Word>OFFSET</Word>
      <Word>ON</Word>
      <Word>ONLY</Word>
      <Word>OPEN</Word>
      <Word>OPENDATASOURCE</Word>
      <Word>OPENJSON</Word>
      <Word>OPENQUERY</Word>
      <Word>OPENROWSET</Word>
      <Word>OPTION</Word>
      <Word>OR</Word>
      <Word>ORDER</Word>
