<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SchemaCompare.ViewModels"
        xmlns:models="clr-namespace:SchemaCompare.Models"
        xmlns:controls="clr-namespace:SchemaCompare.Controls"
        mc:Ignorable="d"
        x:Class="SchemaCompare.QueryBuilderWindow"
        Title="Query Constructor"
        Width="1180" Height="820" MinWidth="920" MinHeight="600"
        CanResize="True" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}">

    <Design.DataContext>
        <vm:QueryBuilderViewModel />
    </Design.DataContext>

    <LayoutTransformControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{DynamicResource UiScale}" ScaleY="{DynamicResource UiScale}" />
        </LayoutTransformControl.LayoutTransform>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══════════ HEADER ═══════════ -->
        <Border Background="{StaticResource HeaderGradient}" Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🧩 Query Constructor" FontSize="20" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Build SELECT queries visually — preview the SQL as you go."
                               FontSize="11" Foreground="#E0D4FF" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionLabel}" FontSize="12" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Classes="secondary" Command="{Binding ResetCommand}" Padding="10,6" FontSize="11"
                            ToolTip.Tip="Reset the whole builder">
                        <TextBlock Text="↺ Reset" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ BODY ═══════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,6,420" Margin="8">

            <!-- ─────────── LEFT: builder sections ─────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">

                    <!-- Tables section -->
                    <Border Classes="card" Padding="14">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Step 1: Choose Tables &amp; Columns" Classes="sectionTitle" />
                                <Button Grid.Column="1" Classes="link" FontSize="11"
                                        Command="{Binding AddTableCommand}"
                                        ToolTip.Tip="Add another table to join or query">
                                    <TextBlock Text="+ Add Table" />
                                </Button>
                            </Grid>
                            <TextBlock Text="Select a table from your database dropdown, or type its name manually." FontSize="11"
                                       Foreground="{StaticResource OnSurfaceVariant}" />
                            <ItemsControl ItemsSource="{Binding Builder.Tables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:BuilderTable">
                                        <Border Background="{StaticResource SubtleHeader}" CornerRadius="6" Padding="8" Margin="0,6">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="80,*,80,Auto">
                                                    <TextBox Grid.Column="0" PlaceholderText="schema" Text="{Binding Schema}" ToolTip.Tip="Schema name (e.g. dbo)" />
                                                    <controls:SearchableComboBox Grid.Column="1"
                                                              ItemsSource="{Binding $parent[Window].DataContext.AvailableTables}"
                                                              SelectedItem="{Binding SelectedTableInfo}"
                                                              SelectionChanged="OnTableSelectionChanged"
                                                              Margin="2,0"
                                                              PlaceholderText="-- Select a table --"
                                                              ToolTip.Tip="Pick a database table from the list">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding DisplayName}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </controls:SearchableComboBox>
                                                    <TextBox Grid.Column="2" PlaceholderText="alias" Text="{Binding Alias}" Margin="2,0,0,0" ToolTip.Tip="Short alias for this table (e.g. t, o, c)" />
                                                    <Button Grid.Column="3" Classes="link" FontSize="11"
                                                            Command="{Binding $parent[Window].DataContext.RemoveTableCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Remove this table">
                                                        <TextBlock Text="✕" />
                                                    </Button>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Columns to display:" FontSize="11" Foreground="{StaticResource OnSurfaceVariant}"
                                                               VerticalAlignment="Center" />
                                                    <Button Classes="link" FontSize="11"
                                                            Command="{Binding $parent[Window].DataContext.AddColumnCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Pick a specific column to display">
                                                        <TextBlock Text="+ Add Column" />
                                                    </Button>
                                                    <Button Classes="link" FontSize="11"
                                                            Command="{Binding $parent[Window].DataContext.SelectAllColumnsCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Show all columns (*)">
                                                        <TextBlock Text="All Columns (*)" />
                                                    </Button>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding SelectedColumns}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="models:SelectedColumn">
                                                            <Grid ColumnDefinitions="*,*,*,Auto" Margin="0,2">
                                                                <TextBox Grid.Column="0" Text="{Binding TableAlias}" PlaceholderText="table alias" ToolTip.Tip="Table alias" />
                                                                <controls:SearchableComboBox Grid.Column="1"
                                                                          ItemsSource="{Binding Table.Columns}"
                                                                          SelectedItem="{Binding ColumnName}"
                                                                          PlaceholderText="Select column..."
                                                                          Margin="2,0" />
                                                                <controls:SearchableComboBox Grid.Column="2"
                                                                          ItemsSource="{Binding $parent[Window].DataContext.Aggregates}"
                                                                          SelectedItem="{Binding Aggregate}"
                                                                          Margin="2,0"
                                                                          ToolTip.Tip="Optional aggregation function (COUNT, SUM, AVG...)" />
                                                                <Button Grid.Column="3" Classes="link" FontSize="11"
                                                                        Command="{Binding $parent[Window].DataContext.RemoveColumnCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="Remove this column">
                                                                    <TextBlock Text="✕" />
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- JOINs section -->
                    <Border Classes="card" Padding="14">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Step 2: Table Relationships (JOINs)" Classes="sectionTitle" />
                                <Button Grid.Column="1" Classes="link" FontSize="11" Command="{Binding AddJoinCommand}"
                                        ToolTip.Tip="Connect another table">
                                    <TextBlock Text="+ Add Join" />
                                </Button>
                            </Grid>
                            <TextBlock Text="Join tables together. The tool automatically detects Foreign Keys when possible!" FontSize="11"
                                       Foreground="{StaticResource OnSurfaceVariant}" />
                            <ItemsControl ItemsSource="{Binding Builder.Joins}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:JoinClause">
                                        <Border Background="{StaticResource SubtleHeader}" CornerRadius="6" Padding="8" Margin="0,4">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="220,80,*,80,Auto">
                                                    <controls:SearchableComboBox Grid.Column="0"
                                                              ItemsSource="{Binding $parent[Window].DataContext.JoinTypeOptions}"
                                                              SelectedValue="{Binding JoinType}"
                                                              SelectedValueBinding="{Binding JoinType}"
                                                              ToolTip.Tip="Type of join (INNER: only matches, LEFT: all from left table)" />
                                                    <TextBox  Grid.Column="1" Text="{Binding RightTable.Schema}" PlaceholderText="schema" Margin="4,0" />
                                                    <controls:SearchableComboBox Grid.Column="2"
                                                              ItemsSource="{Binding $parent[Window].DataContext.AvailableTables}"
                                                              SelectedItem="{Binding RightTable.SelectedTableInfo}"
                                                              SelectionChanged="OnJoinTableSelectionChanged"
                                                              Margin="4,0"
                                                              PlaceholderText="-- Select right table --"
                                                              ToolTip.Tip="Pick right table from database">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding DisplayName}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </controls:SearchableComboBox>
                                                    <TextBox  Grid.Column="3" Text="{Binding RightTable.Alias}" PlaceholderText="alias" Margin="4,0" />
                                                    <Button   Grid.Column="4" Classes="link" FontSize="11"
                                                              Command="{Binding $parent[Window].DataContext.RemoveJoinCommand}"
                                                              CommandParameter="{Binding}"
                                                              ToolTip.Tip="Remove this join">
                                                        <TextBlock Text="✕" />
                                                    </Button>
                                                </Grid>
                                                <Grid ColumnDefinitions="60,*,60,*,Auto">
                                                    <TextBlock Grid.Column="0" Text="ON" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <TextBox  Grid.Column="1" Text="{Binding LeftColumn}" PlaceholderText="leftAlias.Column" Margin="2,0" ToolTip.Tip="e.g. o.CustomerId" />
                                                    <TextBlock Grid.Column="2" Text="=" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                                    <TextBox  Grid.Column="3" Text="{Binding RightColumn}" PlaceholderText="rightAlias.Column" Margin="2,0" ToolTip.Tip="e.g. c.Id" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- WHERE / HAVING filters -->
                    <Border Classes="card" Padding="14">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Step 3: Filter Conditions (WHERE / HAVING)" Classes="sectionTitle" />
                                <Button Grid.Column="1" Classes="link" FontSize="11" Command="{Binding AddFilterCommand}"
                                        ToolTip.Tip="Add a condition to filter your results">
                                    <TextBlock Text="+ Add Filter Condition" />
                                </Button>
                            </Grid>
                            <TextBlock Text="Narrow down data by adding conditions (e.g. Id is null, Status = 1, Amount > 100)." FontSize="11"
                                       Foreground="{StaticResource OnSurfaceVariant}" />
                            <ItemsControl ItemsSource="{Binding Builder.Filters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:FilterCondition">
                                        <Grid ColumnDefinitions="70,80,*,200,*,Auto" Margin="0,4">
                                            <controls:SearchableComboBox Grid.Column="0"
                                                      ItemsSource="{Binding $parent[Window].DataContext.Conjunctions}"
                                                      SelectedItem="{Binding Conjunction}"
                                                      ToolTip.Tip="AND / OR logic" />
                                            <TextBox Grid.Column="1" Text="{Binding TableAlias}" PlaceholderText="alias" Margin="2,0" ToolTip.Tip="Table alias" />
                                            <controls:SearchableComboBox Grid.Column="2"
                                                      ItemsSource="{Binding $parent[Window].DataContext.AvailableColumnNames}"
                                                      SelectedItem="{Binding ColumnName}"
                                                      PlaceholderText="Select column..."
                                                      Margin="2,0" />
                                            <controls:SearchableComboBox Grid.Column="3"
                                                      ItemsSource="{Binding $parent[Window].DataContext.OperatorOptions}"
                                                      SelectedValue="{Binding Operator}"
                                                      SelectedValueBinding="{Binding Operator}"
                                                      Margin="2,0"
                                                      ToolTip.Tip="Comparison operator" />
                                            <TextBox Grid.Column="4" Text="{Binding Value}" PlaceholderText="value (e.g. 10 or text)"
                                                     IsEnabled="{Binding NeedsValue}" Margin="2,0"
                                                     ToolTip.Tip="Value to match. For BETWEEN use '1, 10'. For IN use 'a, b, c'" />
                                            <Button Grid.Column="5" Classes="link" FontSize="11"
                                                    Command="{Binding $parent[Window].DataContext.RemoveFilterCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Remove condition">
                                                <TextBlock Text="✕" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- GROUP BY + ORDER BY + paging -->
                    <Border Classes="card" Padding="14">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Step 4: Grouping (GROUP BY)" Classes="sectionTitle" />
                                <Button Grid.Column="1" Classes="link" FontSize="11" Command="{Binding AddGroupByCommand}"
                                        ToolTip.Tip="Group rows by column for aggregate functions (SUM, COUNT...)">
                                    <TextBlock Text="+ Add Group Column" />
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Builder.GroupBy}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:GroupByItem">
                                        <Grid ColumnDefinitions="120,*,Auto" Margin="0,2">
                                            <TextBox Grid.Column="0" Text="{Binding TableAlias}" PlaceholderText="alias"
                                                     ToolTip.Tip="Table alias, e.g. t1" Margin="0,0,4,0" />
                                            <controls:SearchableComboBox Grid.Column="1"
                                                      ItemsSource="{Binding $parent[Window].DataContext.AvailableColumnNames}"
                                                      SelectedItem="{Binding ColumnName}"
                                                      PlaceholderText="Select column..."
                                                      ToolTip.Tip="Column the rows are grouped by" />
                                            <Button Grid.Column="2" Classes="link" FontSize="11"
                                                    Command="{Binding $parent[Window].DataContext.RemoveGroupByCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Remove group column">
                                                <TextBlock Text="✕" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBlock Text="Step 4b: HAVING (filter aggregated groups)" Classes="sectionTitle" />
                                <Button Grid.Column="1" Classes="link" FontSize="11" Command="{Binding AddHavingCommand}"
                                        ToolTip.Tip="Add a condition on grouped results, e.g. COUNT(*) &gt; 5">
                                    <TextBlock Text="+ Add HAVING Condition" />
                                </Button>
                            </Grid>
                            <TextBlock Text="HAVING filters groups *after* aggregation — only rows whose group matches stay. Example: COUNT(*) &gt; 5 keeps groups with more than 5 rows."
                                       FontSize="11" Foreground="{StaticResource OnSurfaceVariant}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Builder.Having}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:HavingCondition">
                                        <Grid ColumnDefinitions="70,140,80,*,200,*,Auto" Margin="0,4">
                                            <controls:SearchableComboBox Grid.Column="0"
                                                      ItemsSource="{Binding $parent[Window].DataContext.Conjunctions}"
                                                      SelectedItem="{Binding Conjunction}"
                                                      ToolTip.Tip="AND / OR logic with the previous condition" />
                                            <controls:SearchableComboBox Grid.Column="1"
                                                      ItemsSource="{Binding $parent[Window].DataContext.Aggregates}"
                                                      SelectedItem="{Binding Aggregate}"
                                                      Margin="2,0"
                                                      ToolTip.Tip="Aggregate to test, e.g. COUNT(*)" />
                                            <TextBox Grid.Column="2" Text="{Binding TableAlias}" PlaceholderText="alias" Margin="2,0"
                                                     IsEnabled="{Binding NeedsColumn}"
                                                     ToolTip.Tip="Table alias (not needed for COUNT(*))" />
                                            <controls:SearchableComboBox Grid.Column="3"
                                                      ItemsSource="{Binding $parent[Window].DataContext.AvailableColumnNames}"
                                                      SelectedItem="{Binding ColumnName}"
                                                      PlaceholderText="Select column..."
                                                      Margin="2,0"
                                                      IsEnabled="{Binding NeedsColumn}"
                                                      ToolTip.Tip="Column inside the aggregate" />
                                            <controls:SearchableComboBox Grid.Column="4"
                                                      ItemsSource="{Binding $parent[Window].DataContext.OperatorOptions}"
                                                      SelectedValue="{Binding Operator}"
                                                      SelectedValueBinding="{Binding Operator}"
                                                      Margin="2,0"
                                                      ToolTip.Tip="Comparison operator" />
                                            <TextBox Grid.Column="5" Text="{Binding Value}" PlaceholderText="value (e.g. 5)"
                                                     IsEnabled="{Binding NeedsValue}" Margin="2,0"
                                                     ToolTip.Tip="Value to compare the aggregate against. For BETWEEN use '1, 10'" />
                                            <Button Grid.Column="6" Classes="link" FontSize="11"
                                                    Command="{Binding $parent[Window].DataContext.RemoveHavingCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Remove condition">
                                                <TextBlock Text="✕" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator />

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Step 5: Sorting (ORDER BY)" Classes="sectionTitle" />
                                <Button Grid.Column="1" Classes="link" FontSize="11" Command="{Binding AddOrderByCommand}"
                                        ToolTip.Tip="Order results ascending or descending">
                                    <TextBlock Text="+ Add Sort Column" />
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Builder.OrderBy}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:OrderByItem">
                                        <Grid ColumnDefinitions="80,*,120,Auto" Margin="0,2">
                                            <TextBox Grid.Column="0" Text="{Binding TableAlias}" PlaceholderText="alias" ToolTip.Tip="Table alias" />
                                            <controls:SearchableComboBox Grid.Column="1"
                                                      ItemsSource="{Binding $parent[Window].DataContext.AvailableColumnNames}"
                                                      SelectedItem="{Binding ColumnName}"
                                                      PlaceholderText="Select column..."
                                                      Margin="2,0" />
                                            <controls:SearchableComboBox Grid.Column="2"
                                                      ItemsSource="{Binding $parent[Window].DataContext.SortDirections}"
                                                      SelectedItem="{Binding Direction}" Margin="2,0"
                                                      ToolTip.Tip="Asc (A-Z / 1-9) or Desc (Z-A / 9-1)" />
                                            <Button Grid.Column="3" Classes="link" FontSize="11"
                                                    Command="{Binding $parent[Window].DataContext.RemoveOrderByCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Remove sort">
                                                <TextBlock Text="✕" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator />

                            <TextBlock Text="Step 6: Limits &amp; Paging (TOP / DISTINCT / OFFSET)" Classes="sectionTitle" />
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto">
                                <CheckBox  Grid.Column="0" Content="DISTINCT (no duplicates)" IsChecked="{Binding Builder.Distinct}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="TOP"     VerticalAlignment="Center" Margin="12,0,4,0" />
                                <TextBox   Grid.Column="2" Text="{Binding Builder.TopN}" Width="60" ToolTip.Tip="Maximum rows to return (0 = no limit)" />
                                <TextBlock Grid.Column="3" Text="OFFSET"  VerticalAlignment="Center" Margin="12,0,4,0" />
                                <TextBox   Grid.Column="4" Text="{Binding Builder.OffsetRows}" Width="60" ToolTip.Tip="Skip this many rows" />
                                <TextBlock Grid.Column="5" Text="FETCH"   VerticalAlignment="Center" Margin="12,0,4,0" />
                                <TextBox   Grid.Column="6" Text="{Binding Builder.FetchNext}" Width="60" ToolTip.Tip="Next number of rows to retrieve" />
                                <TextBlock Grid.Column="7" Text="rows"    VerticalAlignment="Center" Margin="4,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" />

            <!-- ─────────── RIGHT: live preview ─────────── -->
            <Border Grid.Column="2" Classes="card" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Background="{StaticResource SubtleHeader}" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="Generated SQL" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                       Foreground="{StaticResource OnSurfaceVariant}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding #SqlPreview.LintSummary}" FontSize="11"
                                       Foreground="{StaticResource ErrorPanelText}" TextWrapping="Wrap"
                                       IsVisible="{Binding #SqlPreview.LintSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                    <!-- Shared T-SQL editor: VS-style coloring + IntelliSense come for free
                         (SqlHighlightedEditor is the project-wide SQL text surface). -->
                    <controls:SqlHighlightedEditor x:Name="SqlPreview" Grid.Row="1"
                                                   Text="{Binding Builder.GeneratedSql, Mode=OneWay}"
                                                   IsReadOnly="True"
                                                   EnableLint="True"
                                                   Margin="0" />
                    <TextBlock Grid.Row="2" Text="Preview updates live. Read-only." FontSize="10"
                               Foreground="{StaticResource OnSurfaceVariant}"
                               Padding="10,4" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ FOOTER ═══════════ -->
        <Border Grid.Row="2" Background="{StaticResource SubtleHeader}" Padding="12,10" Margin="8,0,8,8" CornerRadius="4">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Text="Tip: every change updates the SQL on the right."
                           FontSize="11" Foreground="{StaticResource OnSurfaceVariant}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="secondary" Padding="12,8" FontSize="12"
                        Click="OnCancelClick" Margin="0,0,8,0">
                    <TextBlock Text="Cancel" />
                </Button>
                <Button Grid.Column="2" Classes="secondary" Padding="12,8" FontSize="12"
                        Click="OnApplyToActiveClick" Margin="0,0,8,0"
                        ToolTip.Tip="Replace the SQL in the currently selected query tab">
                    <TextBlock Text="Apply to Current Tab" />
                </Button>
                <Button Grid.Column="3" Classes="primary" Padding="14,8" FontSize="12"
                        Click="OnApplyToNewClick"
                        ToolTip.Tip="Open the generated query in a brand-new tab and select it">
                    <TextBlock Text="Apply to New Tab" />
                </Button>
            </Grid>
        </Border>
    </Grid>
    </LayoutTransformControl>
</Window>
