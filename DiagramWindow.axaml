<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SchemaCompare.ViewModels"
        xmlns:models="clr-namespace:SchemaCompare.Models"
        x:Class="SchemaCompare.DiagramWindow"
        x:Name="DiagramRoot"
        Title="DB Diagram" Width="1280" Height="820" MinWidth="900" MinHeight="560"
        CanResize="True" SizeToContent="Manual"
        Background="{StaticResource PageBackground}" WindowStartupLocation="CenterOwner">
    <Design.DataContext><vm:DiagramViewModel /></Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Background="{StaticResource HeaderGradient}" Padding="22,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="DB Diagram" FontSize="{DynamicResource F22}" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Load a database, auto-generate the ER diagram, drag tables to arrange. Layout auto-saves." Foreground="#E0D4FF" FontSize="{DynamicResource F12}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Click="Close_Click"><TextBlock Text="Close" /></Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="card" Margin="16,12,16,0" Padding="14">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="2*,*,*,Auto">
                    <ComboBox ItemsSource="{Binding SavedConnections}"
                              SelectedItem="{Binding SelectedSaved}"
                              PlaceholderText="Saved connection…"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:SavedConnection">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Grid.Column="1" Text="{Binding Server}" PlaceholderText="Server" Margin="8,0,0,0" />
                    <TextBox Grid.Column="2" Text="{Binding Database}" PlaceholderText="Database" Margin="8,0,0,0" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Classes="primary" Command="{Binding LoadSchemaCommand}" IsEnabled="{Binding !IsLoading}"><TextBlock Text="Load schema" /></Button>
                        <Button Classes="link" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding !IsLoading}" Margin="6,0,0,0" VerticalAlignment="Center"><TextBlock Text="Test" /></Button>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton IsChecked="{Binding UseWindowsAuth}" Content="Windows Auth" GroupName="diagAuth" />
                    <RadioButton IsChecked="{Binding !UseWindowsAuth}" Content="SQL Auth" GroupName="diagAuth" Margin="12,0,0,0" />
                    <TextBox Text="{Binding Username}" PlaceholderText="Username" Width="160" Margin="16,0,0,0" IsVisible="{Binding !UseWindowsAuth}" />
                    <TextBox Grid.Column="1" Text="{Binding Password}" PasswordChar="*" PlaceholderText="Password" Width="160" Margin="8,0,0,0" IsVisible="{Binding !UseWindowsAuth}" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search tables…" Width="200" />
                        <Button Classes="secondary" Command="{Binding ZoomOutCommand}" Padding="12,4" ToolTip.Tip="Zoom out (or Ctrl+mouse wheel)"><TextBlock Text="−" /></Button>
                        <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" MinWidth="46" TextAlignment="Center" FontSize="{DynamicResource F12}" />
                        <Button Classes="secondary" Command="{Binding ZoomInCommand}" Padding="12,4" ToolTip.Tip="Zoom in (or Ctrl+mouse wheel)"><TextBlock Text="+" /></Button>
                        <Button Classes="secondary" Command="{Binding ResetZoomCommand}" Padding="10,4" FontSize="{DynamicResource F11}"><TextBlock Text="100%" /></Button>
                        <Rectangle Width="1" Height="20" Fill="{StaticResource CardBorder}" Margin="4,0" VerticalAlignment="Center" />
                        <Button Classes="secondary" Command="{Binding AutoLayoutCommand}"><TextBlock Text="Auto-layout" /></Button>
                        <Button Classes="secondary" Command="{Binding ResetViewCommand}"><TextBlock Text="Reset" /></Button>
                        <Button Classes="secondary" Command="{Binding SaveDiagramCommand}"><TextBlock Text="Save" /></Button>
                        <Button Classes="secondary" Command="{Binding SaveDiagramAsCommand}"><TextBlock Text="Save as…" /></Button>
                        <Button Classes="secondary" Command="{Binding OpenDiagramFileCommand}"><TextBlock Text="Open…" /></Button>
                        <Button Classes="secondary" Command="{Binding ExportPngCommand}" ToolTip.Tip="Save the diagram canvas as a PNG image"><TextBlock Text="📷 PNG…" /></Button>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Text="Tip: Ctrl+mouse-wheel zooms the canvas • 🔗 on any table shows only its relations • drag empty canvas to pan."
                           FontSize="{DynamicResource F11}" Foreground="{StaticResource OnSurfaceVariant}" />
                <Border IsVisible="{Binding ShowError}" Background="{StaticResource ErrorPanelBg}" BorderBrush="{StaticResource ErrorPanelBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding ErrorMessage}" Classes="errorText" />
                        <Button Grid.Column="1" Classes="secondary" Command="{Binding CopyErrorCommand}" Padding="10,4" FontSize="{DynamicResource F11}" Margin="10,0,0,0" VerticalAlignment="Top"><TextBlock Text="Copy" /></Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="250,6,*" Margin="16,8,16,8" MinHeight="200">
            <Border Classes="card" Padding="0">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <Border Background="{StaticResource SubtleHeader}" Padding="14,10" CornerRadius="12,12,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Tables" FontWeight="Bold" FontSize="{DynamicResource F13}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Classes="link" Command="{Binding ShowAllTablesCommand}" Padding="6,2" FontSize="{DynamicResource F11}"><TextBlock Text="All" /></Button>
                                <Button Classes="link" Command="{Binding HideAllTablesCommand}" Padding="6,2" FontSize="{DynamicResource F11}"><TextBlock Text="None" /></Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="Uncheck to hide. 🔗 shows relations, ⌖ focuses a table." FontSize="{DynamicResource F11}" Foreground="{StaticResource OnSurfaceVariant}" Margin="12,6" />
                    <Border Grid.Row="2" Margin="8,0,8,6" Padding="10,8" CornerRadius="8"
                            Background="{StaticResource WarningPanelBg}" BorderBrush="{StaticResource WarningPanelBorder}" BorderThickness="1"
                            IsVisible="{Binding IsIsolated}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding IsolateBannerText}" FontSize="{DynamicResource F11}" Foreground="{StaticResource WarningPanelText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="link" Command="{Binding ClearIsolationCommand}" Padding="8,2" Margin="8,0,0,0" ToolTip.Tip="Show all tables again"><TextBlock Text="✕" /></Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FilteredTables}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:DiagramTableNode">
                                    <Border Padding="10,6" Margin="6,2" CornerRadius="8" Background="{StaticResource InputBackground}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontSize="{DynamicResource F12}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding HeaderSubtitle}" FontSize="{DynamicResource F10p5}" Foreground="{StaticResource OnSurfaceVariant}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="link" Padding="6,2" VerticalAlignment="Center"
                                                    Command="{Binding #DiagramRoot.DataContext.IsolateTableCommand}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="Show only this table's relations">
                                                <TextBlock Text="🔗" FontSize="{DynamicResource F13}" />
                                            </Button>
                                            <Button Grid.Column="3" Classes="link" Padding="6,2" VerticalAlignment="Center"
                                                    Command="{Binding #DiagramRoot.DataContext.FocusTableCommand}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="Center this table in view">
                                                <TextBlock Text="⌖" FontSize="{DynamicResource F14}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" />

            <Border Grid.Column="2" Classes="card" Padding="0">
                <Grid>
                    <ScrollViewer x:Name="DiagramScroll"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <LayoutTransformControl>
                            <LayoutTransformControl.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                            </LayoutTransformControl.LayoutTransform>
                            <Canvas x:Name="DiagramCanvas"
                                    Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                                    Background="#0F0F17" />
                        </LayoutTransformControl>
                    </ScrollViewer>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasSchema}">
                        <TextBlock Text="🗺" FontSize="{DynamicResource F56}" HorizontalAlignment="Center" />
                        <TextBlock Text="Pick a database and click Load schema" FontSize="{DynamicResource F16}" Foreground="{StaticResource OnSurfaceVariant}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="Tables auto-arrange by foreign keys — then drag them anywhere." FontSize="{DynamicResource F13}" Foreground="{StaticResource OnSurfaceVariant}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border IsVisible="{Binding IsLoading}" Background="#B30B0B10">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Loading schema…" FontSize="{DynamicResource F18}" FontWeight="Bold" Foreground="{StaticResource Primary500}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource SubtleHeader}" Padding="16,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusMessage}" FontSize="{DynamicResource F12}" Foreground="{StaticResource OnSurfaceVariant}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CountsText}" FontSize="{DynamicResource F12}" Foreground="{StaticResource PrimaryText}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
