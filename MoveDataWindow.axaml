<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SchemaCompare.Models"
        x:Class="SchemaCompare.MoveDataWindow"
        Title="Move Data" Width="1100" Height="760" MinWidth="640" MinHeight="420"
        CanResize="True" SizeToContent="Manual"
        Background="{StaticResource PageBackground}" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*">
        <Border Background="{StaticResource HeaderGradient}" Padding="22,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Move Data" FontSize="{DynamicResource F22}" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Select source and target databases, inspect relationships, then safely synchronize selected tables." Foreground="#E0D4FF" FontSize="{DynamicResource F12}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Click="Close_Click"><TextBlock Text="Close" /></Button>
            </Grid>
        </Border>
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" MinHeight="280">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="360">
                <StackPanel Margin="20,16,20,8" Spacing="12">
                    <Grid ColumnDefinitions="*,12,*">
                        <Border Classes="card" Padding="16">
                            <StackPanel Spacing="7">
                                <TextBlock Text="SOURCE DATABASE" FontWeight="Bold" Foreground="{StaticResource Primary500}" />
                                <ComboBox ItemsSource="{Binding SavedConnections}" SelectedItem="{Binding SelectedSavedSource}" PlaceholderText="Saved connection">
                                    <ComboBox.ItemTemplate><DataTemplate DataType="models:SavedConnection"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Text="{Binding SourceServer}" PlaceholderText="Server" />
                                <TextBox Text="{Binding SourceDatabase}" PlaceholderText="Database" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton IsChecked="{Binding SourceUseWindowsAuth}" Content="Windows Auth" GroupName="moveSrc" />
                                    <RadioButton IsChecked="{Binding !SourceUseWindowsAuth}" Content="SQL Auth" GroupName="moveSrc" Margin="14,0,0,0" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" IsVisible="{Binding !SourceUseWindowsAuth}">
                                    <TextBox Text="{Binding SourceUsername}" PlaceholderText="Username" />
                                    <TextBox Grid.Column="1" Text="{Binding SourcePassword}" PasswordChar="*" PlaceholderText="Password" Margin="6,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="card" Padding="16">
                            <StackPanel Spacing="7">
                                <TextBlock Text="TARGET DATABASE" FontWeight="Bold" Foreground="{StaticResource Amber}" />
                                <ComboBox ItemsSource="{Binding SavedConnections}" SelectedItem="{Binding SelectedSavedTarget}" PlaceholderText="Saved connection">
                                    <ComboBox.ItemTemplate><DataTemplate DataType="models:SavedConnection"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Text="{Binding TargetServer}" PlaceholderText="Server" />
                                <TextBox Text="{Binding TargetDatabase}" PlaceholderText="Database" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton IsChecked="{Binding TargetUseWindowsAuth}" Content="Windows Auth" GroupName="moveTgt" />
                                    <RadioButton IsChecked="{Binding !TargetUseWindowsAuth}" Content="SQL Auth" GroupName="moveTgt" Margin="14,0,0,0" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" IsVisible="{Binding !TargetUseWindowsAuth}">
                                    <TextBox Text="{Binding TargetUsername}" PlaceholderText="Username" />
                                    <TextBox Grid.Column="1" Text="{Binding TargetPassword}" PasswordChar="*" PlaceholderText="Password" Margin="6,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Classes="card" Padding="16">
                        <StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary" Command="{Binding AnalyzeDataMoveCommand}" IsEnabled="{Binding !IsComparing}"><TextBlock Text="Analyze Tables &amp; Relations" /></Button>
                                    <Button Classes="secondary" Command="{Binding SelectAllDataTablesCommand}" IsVisible="{Binding HasDataMovePlan}"><TextBlock Text="Select Compatible" /></Button>
                                    <Button Classes="secondary" Command="{Binding SelectNoDataTablesCommand}" IsVisible="{Binding HasDataMovePlan}"><TextBlock Text="Clear" /></Button>
                                    <Button Classes="danger" Command="{Binding StartDataMoveCommand}" IsVisible="{Binding HasDataMovePlan}"><TextBlock Text="Start Data Sync" /></Button>
                                </StackPanel>
                            </ScrollViewer>
                            <Border IsVisible="{Binding ShowError}" Background="{StaticResource ErrorPanelBg}" BorderBrush="{StaticResource ErrorPanelBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding ErrorMessage}" Classes="errorText" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding CopyErrorCommand}" Padding="10,4" FontSize="{DynamicResource F11}" Margin="10,0,0,0" VerticalAlignment="Top"><TextBlock Text="Copy" /></Button>
                                </Grid>
                            </Border>
                            <StackPanel IsVisible="{Binding HasDataMovePlan}" Margin="0,12,0,0">
                                <TextBlock Text="{Binding DataMoveSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DataMoveRelationshipSummary}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="{DynamicResource F12}" Foreground="{StaticResource OnSurfaceVariant}" />
                                <TextBlock Text="Required parent tables are added automatically and handled before children. Target-only rows are never deleted." Margin="0,4,0,0" FontSize="{DynamicResource F12}" Foreground="{StaticResource Amber}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Row="1" Height="6" ResizeDirection="Rows" />

            <Grid Grid.Row="2" ColumnDefinitions="*,6,*" Margin="20,0,20,8" MinHeight="140">
                <Border Classes="card" Padding="0" IsVisible="{Binding HasDataMovePlan}">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Border Background="{StaticResource SubtleHeader}" Padding="14,10"><TextBlock Text="Tables to synchronize" FontWeight="Bold" /></Border>
                        <TextBox Grid.Row="1" Text="{Binding DataMoveFilterText}" PlaceholderText="Search tables or status to include/exclude…" Margin="10,8" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredDataMoveTables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:DataMoveTable">
                                        <Border Padding="12,9" Margin="4,2" CornerRadius="8" Background="{StaticResource InputBackground}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsCompatible}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource F11}" Foreground="{StaticResource OnSurfaceVariant}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBox Grid.Column="2" Text="{Binding Warning}" Classes="errorText" MinWidth="160" MaxWidth="320" VerticalAlignment="Center" IsVisible="{Binding !IsCompatible}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" IsVisible="{Binding HasDataMovePlan}" />
                <Border Grid.Column="2" Classes="card" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Border Background="{StaticResource CodeBg}" Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Operation Logs" FontWeight="Bold" Foreground="#CDD6F4" />
                                <Button Grid.Column="1" Classes="secondary" Click="CopyLogs_Click" Padding="10,4"><TextBlock Text="Copy Log" /></Button>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding LogText}" Classes="codeBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" PlaceholderText="Errors and synchronization progress will appear here." />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsComparing}" Background="#B30B0B10" ZIndex="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Working…" FontSize="{DynamicResource F18}" FontWeight="Bold" Foreground="{StaticResource Primary500}" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="110" IsVisible="{Binding ShowDataMoveConfirmation}" Background="{StaticResource WarningPanelBg}" BorderBrush="{StaticResource WarningPanelBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="480">
                        <TextBlock Text="Synchronize selected data into the target?" FontWeight="Bold" />
                        <TextBlock Text="Matching primary-key rows are updated and missing rows inserted. Target-only rows are retained." TextWrapping="Wrap" Margin="0,8,0,14" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <Button Classes="danger" Command="{Binding ConfirmDataMoveCommand}"><TextBlock Text="Yes, Sync" /></Button>
                            <Button Classes="secondary" Command="{Binding CancelDataMoveCommand}"><TextBlock Text="Cancel" /></Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
