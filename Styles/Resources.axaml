<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark near-black theme with violet accent. Text colors are brightened for contrast. -->
    <Color x:Key="Primary500">#A78BFA</Color>
    <Color x:Key="PrimaryContainer">#2A2140</Color>
    <Color x:Key="OnSurfaceVariant">#B9B9CE</Color>
    <Color x:Key="Error">#F87171</Color>
    <Color x:Key="Success">#34D399</Color>
    <Color x:Key="Amber">#FBBF24</Color>
    <Color x:Key="GradientStart">#0B0B12</Color>
    <Color x:Key="GradientEnd">#3B1D7A</Color>
    <Color x:Key="CodeBg">#0E0E15</Color>

    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource GradientStart}" />
        <GradientStop Offset="0.55" Color="#1B1235" />
        <GradientStop Offset="1" Color="{StaticResource GradientEnd}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Amber}" />

    <!-- Surfaces -->
    <Color x:Key="PageBackground">#0B0B10</Color>
    <Color x:Key="CardBackground">#14141C</Color>
    <Color x:Key="CardBorder">#2A2A3D</Color>
    <Color x:Key="SubtleHeader">#1D1D2A</Color>
    <Color x:Key="InputBackground">#0F0F17</Color>
    <Color x:Key="InputBorder">#3A3A55</Color>
    <Color x:Key="PrimaryText">#F2F2F7</Color>
    <Color x:Key="SecondaryButton">#23232F</Color>

    <!-- Status panels -->
    <Color x:Key="SuccessPanelBg">#0C2A1D</Color>
    <Color x:Key="SuccessPanelBorder">#34D399</Color>
    <Color x:Key="SuccessPanelText">#6EE7B7</Color>
    <Color x:Key="WarningPanelBg">#2C2111</Color>
    <Color x:Key="WarningPanelBorder">#FBBF24</Color>
    <Color x:Key="WarningPanelText">#FCD34D</Color>
    <Color x:Key="ErrorPanelBg">#2C1215</Color>
    <Color x:Key="ErrorPanelBorder">#F87171</Color>
    <Color x:Key="ErrorPanelText">#FCA5A5</Color>

    <!-- Scalable font sizes. Referenced via {DynamicResource Fxx} so the
         Settings text-size slider can resize all text live (see UiFontSizes). -->
    <x:Double x:Key="F10">10</x:Double>
    <x:Double x:Key="F10p5">10.5</x:Double>
    <x:Double x:Key="F11">11</x:Double>
    <x:Double x:Key="F11p5">11.5</x:Double>
    <x:Double x:Key="F12">12</x:Double>
    <x:Double x:Key="F12p5">12.5</x:Double>
    <x:Double x:Key="F13">13</x:Double>
    <x:Double x:Key="F14">14</x:Double>
    <x:Double x:Key="F15">15</x:Double>
    <x:Double x:Key="F16">16</x:Double>
    <x:Double x:Key="F18">18</x:Double>
    <x:Double x:Key="F20">20</x:Double>
    <x:Double x:Key="F21">21</x:Double>
    <x:Double x:Key="F22">22</x:Double>
    <x:Double x:Key="F24">24</x:Double>
    <x:Double x:Key="F32">32</x:Double>
    <x:Double x:Key="F56">56</x:Double>
    <x:Double x:Key="F64">64</x:Double>
</ResourceDictionary>
