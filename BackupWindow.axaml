<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SchemaCompare.BackupWindow"
        Title="Local Database Backup"
        Width="760" Height="520" MinWidth="520" MinHeight="360"
        CanResize="True" SizeToContent="Manual"
        Background="{StaticResource PageBackground}" WindowStartupLocation="CenterOwner">
    <LayoutTransformControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </LayoutTransformControl.LayoutTransform>
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Background="{StaticResource HeaderGradient}" Padding="20,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Local Database Backup" FontSize="21" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Portable BACPAC export (schema + data) saved directly to this PC." Foreground="#E0D4FF" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Click="Close_Click"><TextBlock Text="Close" /></Button>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22" Spacing="12">
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="Database to export" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton IsChecked="{Binding BackupUsesSource}" Content="Source database" GroupName="backupDb" />
                            <RadioButton IsChecked="{Binding !BackupUsesSource}" Content="Target database" GroupName="backupDb" Margin="20,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="A BACPAC is the professional local-file alternative for remote SQL Server. A .bak can only be written by the SQL Server service to a path it can access." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource OnSurfaceVariant}" Margin="0,10,0,0" />
                        <TextBlock Text="If a procedure uses [DatabaseName].[dbo].[Table], DAC validation (SQL71562) fails. This app retries the export without that check so the file can still be saved." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Amber}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="Save on this PC" FontWeight="Bold" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <TextBox Text="{Binding BackupDestinationPath}" PlaceholderText="Choose a .bacpac destination" />
                            <Button Grid.Column="1" Classes="secondary" Click="Browse_Click" Margin="8,0,0,0"><TextBlock Text="Browse…" /></Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border IsVisible="{Binding ShowError}" Background="{StaticResource ErrorPanelBg}" BorderBrush="{StaticResource ErrorPanelBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding ErrorMessage}" Classes="errorText" />
                        <Button Grid.Column="1" Classes="secondary" Command="{Binding CopyErrorCommand}" Padding="10,4" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Top"><TextBlock Text="Copy" /></Button>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding BackupStatus}" TextWrapping="Wrap" Foreground="{StaticResource OnSurfaceVariant}" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="20,12" Background="{StaticResource CardBackground}">
            <Button Classes="primary" Command="{Binding ExportBackupCommand}" IsEnabled="{Binding !IsBackingUp}" HorizontalAlignment="Right">
                <TextBlock Text="Export Local .bacpac" />
            </Button>
        </Border>
    </Grid>
    </LayoutTransformControl>
</Window>
