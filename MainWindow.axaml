<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SchemaCompare.ViewModels"
        xmlns:models="clr-namespace:SchemaCompare.Models"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="SchemaCompare.MainWindow"
        Title="Schema Compare - Database Diff Tool"
        Width="1200" Height="800" MinWidth="900" MinHeight="600"
        Background="#F5F0FF" WindowStartupLocation="CenterScreen">
    <Design.DataContext><vm:MainViewModel /></Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Background="{StaticResource HeaderGradient}" Padding="24,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Schema Compare" FontSize="24" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Compare SQL Server database schemas side by side" FontSize="13" Foreground="#E0D4FF" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#40FFFFFF" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="13" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="20,16" Background="#F5F0FF">
            <Grid ColumnDefinitions="*,Auto,*">
                <Border Classes="card" Padding="20">
                    <StackPanel>
                        <TextBlock Text="SOURCE DATABASE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Primary500}" LetterSpacing="1" />
                        <Rectangle Height="2" Fill="{StaticResource HeaderGradient}" Margin="0,6,0,12" />
                        <TextBlock Text="Server" Classes="sectionTitle" />
                        <TextBox Text="{Binding SourceServer}" PlaceholderText="localhost, (local), or IP" />
                        <TextBlock Text="Database" Classes="sectionTitle" Margin="0,10,0,0" />
                        <TextBox Text="{Binding SourceDatabase}" PlaceholderText="Database name" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton IsChecked="{Binding SourceUseWindowsAuth}" Content="Windows Auth" GroupName="srcAuth" />
                            <RadioButton IsChecked="{Binding !SourceUseWindowsAuth}" Content="SQL Auth" GroupName="srcAuth" Margin="16,0,0,0" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" Margin="0,8,0,0" IsVisible="{Binding !SourceUseWindowsAuth}">
                            <TextBox Text="{Binding SourceUsername}" PlaceholderText="Username" />
                            <TextBox Grid.Column="1" Text="{Binding SourcePassword}" PlaceholderText="Password" PasswordChar="*" Margin="8,0,0,0" />
                        </Grid>
                        <Button Classes="link" Command="{Binding TestSourceConnectionCommand}" IsEnabled="{Binding !IsComparing}" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="8,4" FontSize="11"><TextBlock Text="Test Connection" /></Button>
                        <StackPanel Margin="0,8,0,0" IsVisible="{Binding SourceHasConnectionResult}">
                            <Border CornerRadius="6" Padding="10,6" IsVisible="{Binding SourceConnectionOk}"
                                    Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="1">
                                <TextBlock Text="{Binding SourceConnectionStatus}" FontSize="12" FontWeight="SemiBold" Foreground="#2E7D32" />
                            </Border>
                            <Border CornerRadius="6" Padding="10,6" IsVisible="{Binding !SourceConnectionOk}"
                                    Background="#FFEBEE" BorderBrush="#F44336" BorderThickness="1">
                                <TextBlock Text="{Binding SourceConnectionStatus}" FontSize="12" FontWeight="SemiBold" Foreground="#C62828" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Grid.Column="1" Classes="primary" Command="{Binding CompareCommand}" IsEnabled="{Binding !IsComparing}" VerticalAlignment="Center" Margin="16,0" Padding="16,28" FontSize="13">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#x21C4;" FontSize="24" HorizontalAlignment="Center" />
                        <TextBlock Text="Compare" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="2" Classes="card" Padding="20">
                    <StackPanel>
                        <TextBlock Text="TARGET DATABASE" FontSize="12" FontWeight="Bold" Foreground="#F57F17" LetterSpacing="1" />
                        <Rectangle Height="2" Fill="{StaticResource WarningBrush}" Margin="0,6,0,12" />
                        <TextBlock Text="Server" Classes="sectionTitle" />
                        <TextBox Text="{Binding TargetServer}" PlaceholderText="localhost, (local), or IP" />
                        <TextBlock Text="Database" Classes="sectionTitle" Margin="0,10,0,0" />
                        <TextBox Text="{Binding TargetDatabase}" PlaceholderText="Database name" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton IsChecked="{Binding TargetUseWindowsAuth}" Content="Windows Auth" GroupName="tgtAuth" />
                            <RadioButton IsChecked="{Binding !TargetUseWindowsAuth}" Content="SQL Auth" GroupName="tgtAuth" Margin="16,0,0,0" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" Margin="0,8,0,0" IsVisible="{Binding !TargetUseWindowsAuth}">
                            <TextBox Text="{Binding TargetUsername}" PlaceholderText="Username" />
                            <TextBox Grid.Column="1" Text="{Binding TargetPassword}" PlaceholderText="Password" PasswordChar="*" Margin="8,0,0,0" />
                        </Grid>
                        <Button Classes="link" Command="{Binding TestTargetConnectionCommand}" IsEnabled="{Binding !IsComparing}" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="8,4" FontSize="11"><TextBlock Text="Test Connection" /></Button>
                        <StackPanel Margin="0,8,0,0" IsVisible="{Binding TargetHasConnectionResult}">
                            <Border CornerRadius="6" Padding="10,6" IsVisible="{Binding TargetConnectionOk}"
                                    Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="1">
                                <TextBlock Text="{Binding TargetConnectionStatus}" FontSize="12" FontWeight="SemiBold" Foreground="#2E7D32" />
                            </Border>
                            <Border CornerRadius="6" Padding="10,6" IsVisible="{Binding !TargetConnectionOk}"
                                    Background="#FFEBEE" BorderBrush="#F44336" BorderThickness="1">
                                <TextBlock Text="{Binding TargetConnectionStatus}" FontSize="12" FontWeight="SemiBold" Foreground="#C62828" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="2" Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsComparing}" IsVisible="{Binding IsComparing}" Foreground="{StaticResource HeaderGradient}" Background="#E8DEF8" Height="6" />

        <Grid Grid.Row="3" Margin="20,8,20,8">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" IsVisible="{Binding HasResults}">
                <!-- Toolbar row -->
                <Border Classes="card" Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                        <TextBlock Text="{Binding ResultSummaryText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,0,0">
                            <Border Background="#E8F5E9" CornerRadius="6" Padding="8,4">
                                <CheckBox IsChecked="{Binding ShowAdded}" Content="{Binding AddedFilterText}" Foreground="{StaticResource Success}" />
                            </Border>
                            <Border Background="#FFF8E1" CornerRadius="6" Padding="8,4" Margin="8,0,0,0">
                                <CheckBox IsChecked="{Binding ShowChanged}" Content="{Binding ChangedFilterText}" Foreground="#F57F17" />
                            </Border>
                            <Border Background="#FFEBEE" CornerRadius="6" Padding="8,4" Margin="8,0,0,0">
                                <CheckBox IsChecked="{Binding ShowDeleted}" Content="{Binding DeletedFilterText}" Foreground="{StaticResource Error}" />
                            </Border>
                        </StackPanel>
                        <!-- Select All / Deselect All -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Button Classes="secondary" Command="{Binding SelectAllCommand}" Padding="10,4" FontSize="11"><TextBlock Text="✓ All" /></Button>
                            <Button Classes="secondary" Command="{Binding DeselectAllCommand}" Padding="10,4" FontSize="11" Margin="4,0,0,0"><TextBlock Text="✗ None" /></Button>
                        </StackPanel>
                        <Button Grid.Column="4" Classes="secondary" Command="{Binding GenerateScriptCommand}" Margin="12,0,0,0" Padding="16,6"><TextBlock Text="Generate Script" /></Button>
                        <Button Grid.Column="5" Classes="primary" Click="ApplyButton_Click" IsEnabled="{Binding !IsComparing}" Margin="8,0,0,0" Padding="16,6"><TextBlock Text="Apply to Target" /></Button>
                    </Grid>
                </Border>

                <!-- Diff list + detail pane -->
                <Grid Grid.Row="2" ColumnDefinitions="*,4,*" Margin="0,8,0,0" MaxHeight="340">
                    <Border Classes="card" Padding="0">
                        <Grid RowDefinitions="Auto,*">
                            <Border Background="#F3EDF7" Padding="14,10"><TextBlock Text="Differences" FontWeight="Bold" FontSize="13" /></Border>
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding FilteredDifferences}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:SchemaDiffItem">
                                            <Border Padding="12,8" Margin="4,2" CornerRadius="8" Background="{Binding RowBackground}" PointerPressed="DiffItem_PointerPressed">
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                    <!-- Selection checkbox -->
                                                    <CheckBox IsChecked="{Binding IsIncluded}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                                    </Border>
                                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding ObjectName}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{Binding ObjectType}" FontSize="11" Foreground="{StaticResource OnSurfaceVariant}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="4" Background="#E8DEF8" />
                    <Border Grid.Column="2" Classes="card" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Border Background="#F3EDF7" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Detail" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="{Binding SelectedObjectName}" FontSize="11" Foreground="{StaticResource OnSurfaceVariant}" IsVisible="{Binding HasSelection}" />
                                </StackPanel>
                                <Border Grid.Column="1" Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                                        BorderBrush="{StaticResource Primary500}" BorderThickness="1"
                                        IsVisible="{Binding HasSelection}">
                                    <TextBlock Text="{Binding SelectedObjectType}" FontSize="11" Foreground="{StaticResource Primary500}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" IsVisible="{Binding HasSelection}">
                            <Grid ColumnDefinitions="*,2,*">
                                <Border Padding="8" IsVisible="{Binding HasTargetScript}">
                                    <Grid RowDefinitions="Auto,*">
                                        <Border Background="#FFF3E0" Padding="8,4" CornerRadius="4,4,0,0">
                                            <TextBlock Text="Target (Current)" FontWeight="SemiBold" FontSize="12" Foreground="#E65100" />
                                        </Border>
                                        <ScrollViewer Grid.Row="1">
                                            <!-- IsReadOnly TextBox: CopyingToClipboard handled safely, no cut allowed -->
                                            <TextBox Text="{Binding TargetScriptContent}" Classes="codeBox" IsReadOnly="True"
                                                     KeyDown="CodeBox_KeyDown" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                <GridSplitter Grid.Column="1" Width="2" Background="#E8DEF8" />
                                <Border Grid.Column="2" Padding="8" IsVisible="{Binding HasSourceScript}">
                                    <Grid RowDefinitions="Auto,*">
                                        <Border Background="#E8F5E9" Padding="8,4" CornerRadius="4,4,0,0">
                                            <TextBlock Text="Source (New)" FontWeight="SemiBold" FontSize="12" Foreground="#1B5E20" />
                                        </Border>
                                        <ScrollViewer Grid.Row="1">
                                            <TextBox Text="{Binding SourceScriptContent}" Classes="codeBox" IsReadOnly="True"
                                                     KeyDown="CodeBox_KeyDown" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Border Padding="16" IsVisible="{Binding !HasTargetScript}">
                                <TextBlock Text="Only source script available" FontStyle="Italic" Foreground="{StaticResource OnSurfaceVariant}" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Padding="16" IsVisible="{Binding !HasSelection}">
                            <TextBlock Text="Select a difference to view details" Foreground="{StaticResource OnSurfaceVariant}" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                </Grid>

                <!-- Apply confirmation banner -->
                <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" ZIndex="50"
                        Background="#FFF8E1" BorderBrush="#F57F17" BorderThickness="1" CornerRadius="8" Padding="20,12"
                        IsVisible="{Binding ShowApplyConfirmation}">
                    <ScrollViewer MaxHeight="300">
                        <StackPanel>
                            <TextBlock Text="Apply changes to target database?" FontWeight="SemiBold" FontSize="14" Foreground="#E65100" />
                            <TextBlock Text="{Binding ResultSummaryText}" Margin="0,4,0,4" FontSize="12" Foreground="{StaticResource OnSurfaceVariant}" />
                            <TextBlock Text="Only checked items in the list will be applied." FontSize="11" Foreground="#888" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Classes="primary" Command="{Binding ConfirmApplyCommand}" Padding="20,8" Margin="0,0,12,0"><TextBlock Text="Yes, Apply" /></Button>
                                <Button Classes="secondary" Command="{Binding CancelApplyCommand}" Padding="20,8"><TextBlock Text="Cancel" /></Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Deployment script panel -->
                <Border Grid.Row="3" Classes="card" Padding="0" Margin="0,8,0,0" IsVisible="{Binding HasFullScript}" MinHeight="150">
                    <Grid RowDefinitions="Auto,*">
                        <Border Background="#1E1E2E" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Deployment Script" FontWeight="Bold" FontSize="13" Foreground="#CDD6F4" />
                                <Button Grid.Column="1" Background="#3A3A4A" Foreground="#CDD6F4" CornerRadius="6" Padding="10,4" FontSize="11" Click="CopyScript_Click"><TextBlock Text="Copy" /></Button>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1">
                            <TextBox Text="{Binding FullDeployScript}" Classes="codeBox" IsReadOnly="True" MinHeight="120"
                                     KeyDown="CodeBox_KeyDown" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Logs panel -->
                <Border Grid.Row="4" Classes="card" Padding="0" Margin="0,8,0,0" IsVisible="{Binding HasLogs}" MaxHeight="160">
                    <Grid RowDefinitions="Auto,*">
                        <Border Background="#1E1E2E" Padding="10,6">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Text="Operation Log" FontWeight="Bold" FontSize="12" Foreground="#CDD6F4" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Background="#3A3A4A" Foreground="#CDD6F4" CornerRadius="6" Padding="10,4" FontSize="11" Click="CopyLogs_Click" Margin="0,0,6,0"><TextBlock Text="Copy Log" /></Button>
                                <Button Grid.Column="2" Background="#3A3A4A" Foreground="#CDD6F4" CornerRadius="6" Padding="10,4" FontSize="11" Command="{Binding ClearLogsCommand}"><TextBlock Text="Clear" /></Button>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer">
                            <TextBox Text="{Binding LogText}" Classes="codeBox" IsReadOnly="True" FontSize="11"
                                     KeyDown="CodeBox_KeyDown" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasResults}">
                <TextBlock Text="&#x1F50D;" FontSize="64" HorizontalAlignment="Center" />
                <TextBlock Text="Enter connection details and click Compare" FontSize="16" Foreground="{StaticResource OnSurfaceVariant}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Text="Discover schema differences between two databases" FontSize="13" Foreground="{StaticResource OnSurfaceVariant}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
            <Border VerticalAlignment="Bottom" Background="#FFEBEE" BorderBrush="{StaticResource Error}" BorderThickness="1" CornerRadius="8" Padding="16,10"
                    IsVisible="{Binding ShowError}" ZIndex="50">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="&#x26A0;" FontSize="18" Foreground="{StaticResource Error}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Margin="10,0,0,0" Foreground="{StaticResource Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="1" Grid.RowSpan="3" IsVisible="{Binding IsComparing}" Background="#80FFFFFF" ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource HeaderGradient}">
                    <TextBlock Text="&#x21BB;" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,16,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Primary500}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
